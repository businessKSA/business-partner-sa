# Business Partner — local development (copy to .env.local, never commit it)
#
#   cp .env.local.example .env.local
#   npm run dev        →  http://localhost:3000
#
# Everything below is already the default in site/scripts/devserver.mjs; the
# file exists so you can override one value without memorising the names.

APP_ENV=development

# Data — a JSON file under .localdb/, seeded from db/seed.local.json.
# Production Supabase is never contacted while this is 1.
LOCAL_DB=1

# Simple V1
SIMPLE_V1=1              # the new homepage takes over "/" locally
SIMPLE_TEST_MODE=1       # in-portal signature, simulated payment, test invoice
SIMPLE_OPS_KEY=test-ops  # key for /ops
SIMPLE_TEST_OTP=123456   # fixed sign-in code for *@test.local

# Safe modes — nothing here may touch a real customer, card or phone.
PAYMENTS_MODE=test
MOYASAR_MODE=test
TAMARA_MODE=sandbox
WHATSAPP_MODE=mock
EMAIL_MODE=preview       # e-mails are recorded in .localdb/outbox.json
CONTRACT_MODE=test
CALENDAR_MODE=test

# Azure Database for PostgreSQL — for the production cutover ONLY
# (ops/azure/README.md §5). Leave both unset locally: LOCAL_DB=1 wins and
# the whole persistence layer stays in .localdb/. Without DB_DRIVER=azure the
# `pg` driver is never even loaded; with it but without AZURE_PG_URL the API
# reports the missing variable instead of silently using Supabase.
# The only local use of a real Postgres is the driver test — see
# docs/local-development.md, which uses AZPG_TEST_URL, not these two.
# DB_DRIVER=azure
# AZURE_PG_URL=postgres://user:pass@host:5432/db?sslmode=require

# Optional: a real Anthropic key makes the unified chat answer for real.
# Without it the chat endpoint replies with its configured fallback.
# ANTHROPIC_API_KEY=

# PORT=3000
