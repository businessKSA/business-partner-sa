        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b=$input.first().json.body||{};const code=((b.code||'')+'').trim().toUpperCase();const raw=(b.names&&typeof b.names==='object')?b.names:{};const ALLOWED=['khaled','baher','mazen','nasser','mishari','abdulrahman','abdulaziz','badr','farah','malak','mohammed','abdullah','ahmed','strategy'];const names={};for(const k of ALLOWED){const v=raw[k];if(typeof v==='string'){const t=v.trim().slice(0,40);if(t)names[k]=t;}}const ok=!!code&&code!=='DEMO123';const qBody=JSON.stringify({filter:{property:'الرمز',rich_text:{equals:ok?code:'NONE'}}});return [{json:{code:code,ok:ok,names:names,namesStr:JSON.stringify(names),qBody:qBody}}];"
