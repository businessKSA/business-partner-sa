        "jsCode": "const pre=$('Prep').first().json;const r=$input.first().json.results||[];if(!pre.ok||!r.length){return [{json:{ok:false}}];}const p=r[0].properties||{};const st=((p['الحالة']||{}).select||{}).name||'نشط';if(st!=='نشط'){return [{json:{ok:false}}];}const pageId=r[0].id;const patchBody=JSON.stringify({properties:{'AgentNames':{rich_text:[{text:{content:pre.namesStr.slice(0,1900)}}]}}});return [{json:{ok:true,url:'https://api.notion.com/v1/pages/'+pageId,patchBody:patchBody,names:pre.names}}];"
