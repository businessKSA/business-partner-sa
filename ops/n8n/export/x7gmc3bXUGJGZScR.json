      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst platforms = ['Instagram','Facebook','LinkedIn','Snapchat','TikTok','WhatsApp Channel','Telegram Channel'];\nconst statuses = ['Idea','Draft','Needs Design','Ready for Review','Approved','Scheduled','Published','Rejected'];\nconst counts = {};\nstatuses.forEach(s => counts[s] = 0);\nconst byPlatform = {};\nplatforms.forEach(p => byPlatform[p] = { total: 0, published: 0, needsReview: 0 });\nconst needsReview = [];\nconst thisWeek = [];\nconst posts = [];\nconst now = new Date();\nconst weekFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);\nitems.forEach(it => {\n  const status = it.property_status || '';\n  const platform = it.property_platform || '';\n  if (counts[status] !== undefined) counts[status]++;\n  if (byPlatform[platform]) {\n    byPlatform[platform].total++;\n    if (status === 'Published') byPlatform[platform].published++;\n    if (status === 'Ready for Review') byPlatform[platform].needsReview++;\n  }\n  const row = {\n    id: it.id,\n    title: it.property_post_title || it.name || '',\n    platform: platform,\n    status: status,\n    pillar: it.property_content_pillar || '',\n    captionAr: it.property_caption_arabic || '',\n    captionEn: it.property_caption_english || '',\n    hashtags: it.property_hashtags || '',\n    designBrief: it.property_design_brief || '',\n    designUrl: it.property_design_asset_url || '',\n    scheduledDate: it.property_scheduled_date || null,\n    publishedDate: it.property_published_date || null,\n    approvedBy: it.property_approved_by || '',\n    notes: it.property_notes || ''\n  };\n  posts.push(row);\n  if (status === 'Ready for Review') needsReview.push(row);\n  if (row.scheduledDate) {\n    const d = new Date(row.scheduledDate);\n    if (d >= now && d <= weekFromNow) thisWeek.push(row);\n  }\n});\nreturn [{ json: {\n  ok: true,\n  generatedAt: new Date().toISOString(),\n  counts: counts,\n  byPlatform: byPlatform,\n  needsReview: needsReview,\n  thisWeek: thisWeek,\n  posts: posts\n} }];"
      }
    },
