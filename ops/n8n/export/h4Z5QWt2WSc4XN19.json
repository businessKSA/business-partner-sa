    {
      "id": "5578a362-9376-4197-8bde-6cddbc4056a7",
      "name": "Pick Stale Tasks (>24h, max 10)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// A task left in_progress with no update for more than 24h is invisible work.\n// Send it back to the Virtual Baher Task Review Loop (k5vtioWWKC2i1W0n), which\n// closes, reassigns, schedules a wait, or escalates it.\n// Skipped: recirculation chains (-RECIRC-2 and deeper) are parked on purpose,\n// and rows already review_status=pending are already in the reviewer's queue.\n// Several rows can share one task_id; the update matches by task_id, so one\n// item per task_id is enough.\nconst DAY = 24 * 60 * 60 * 1000;\nconst now = Date.now();\nconst LOOP = /-RECIRC-([2-9]|\\d{2,})$/;\nconst seen = {};\nconst out = [];\nfor (const it of $input.all()) {\n  const t = it.json || {};\n  const id = String(t.task_id || '').trim();\n  if (!id || seen[id]) continue;\n  if (LOOP.test(id)) continue;\n  if (String(t.review_status || '') === 'pending') continue;\n  const ts = Date.parse(t.updated_at || t.updatedAt || '');\n  if (!Number.isFinite(ts) || now - ts <= DAY) continue;\n  seen[id] = true;\n  out.push({ json: { task_id: id, stale_hours: Math.round((now - ts) / 3600000), updated_at_before: t.updated_at || t.updatedAt } });\n  if (out.length >= 10) break;\n}\nreturn out;"
      }
    },
    {
      "id": "e7fc0ce9-ee10-4c2f-a2c3-edda838f5f36",
