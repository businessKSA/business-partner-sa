      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TRUSTED=/(\\.gov\\.sa|\\.org\\.sa|investsaudi\\.sa|invest\\.sa)/i;const BLOCKED=/(setupinsaudi|astrolabs|knowledge[ _]?feed|test[ _]?source)/i;const rows=$input.all().map(i=>i.json);const items=rows.filter(r=>{const im=(r.property_impact_level||'').toLowerCase();const u=r.property_original_url||'';const s=r.property_source_name||'';return (im==='critical'||im==='high')&&TRUSTED.test(u)&&!BLOCKED.test(u)&&!BLOCKED.test(s);}).slice(0,5);const esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');const dom=u=>{try{return new URL(u).hostname.replace(/^www\\./,'');}catch(e){return '';}};const blocks=items.map(r=>`<div style=\"padding:15px 22px;border-bottom:1px solid #E4E7F0\"><div style=\"font-size:10px;font-weight:bold;color:#13246e;background:#eef0f7;display:inline-block;padding:2px 8px;border-radius:5px\">${esc(r.property_impact_level||'')}</div><h4 style=\"margin:6px 0 5px;font-size:14.5px;color:#1F2430\">${esc(r.property_update_title||'')}</h4><p style=\"margin:0 0 9px;font-size:12.7px;color:#39404f;line-height:1.75\">${esc(r.property_summary_arabic||r.property_what_it_means||'')}</p><div style=\"background:#F5F6FA;border-right:3px solid #0B1B5A;border-radius:8px;padding:9px 12px;font-size:12px;color:#39404f\"><b style=\"color:#0B1B5A;font-size:10px;display:block;margin-bottom:3px\">قراءة BUSINESS PARTNER</b>${esc(r.property_business_opportunity||'فريقنا يتابع هذا التحديث ويطبّقه على ملفات عملائنا.')}</div><div style=\"margin-top:8px;font-size:11.5px;color:#4a4f5e\">المصدر: <b style=\"color:#0B1B5A\">${esc(dom(r.property_original_url))}</b></div></div>`).join('');const today=$now.toFormat('yyyy-LL-dd');const html=`<div dir=\"rtl\" style=\"font-family:Tahoma,Arial,sans-serif;max-width:640px;margin:auto;background:#fff;color:#1F2430\"><div style=\"background:#0B1B5A;padding:22px;text-align:center\"><div style=\"font-size:11px;font-weight:bold;letter-spacing:2px;color:#c7d0ee\">BUSINESS PARTNER · WEEKLY BRIEF</div><div style=\"font-size:19px;font-weight:bold;color:#fff;margin-top:7px\">نشرة الأسبوع — أهم المستجدات التنظيمية</div><div style=\"font-size:12px;color:#aab6e0;margin-top:2px\">${today}</div></div><div style=\"padding:14px 22px;border-bottom:1px solid #E4E7F0;font-size:13px;color:#4a4f5e\">راقبنا الجهات الحكومية لك — إليك أهم ما يخص أعمالك هذا الأسبوع من مصادر رسمية موثوقة.</div>${blocks||'<div style=\"padding:20px;text-align:center;color:#4a4f5e\">لا توجد تحديثات جوهرية هذا الأسبوع.</div>'}<div style=\"background:#0B1B5A;padding:20px;text-align:center\"><p style=\"margin:0 0 12px;font-size:13px;color:#b9c2e4\">محتاج تتأكد إن منشأتك ممتثلة أو تبي تتحرك على فرصة؟</p><a href=\"https://businesspartner.sa/ar/consultation\" style=\"background:#fff;color:#0B1B5A;text-decoration:none;font-size:12.5px;font-weight:bold;padding:9px 16px;border-radius:999px\">احجز استشارة</a></div><div style=\"background:#F5F6FA;color:#4a4f5e;font-size:10.5px;text-align:center;padding:13px 20px;line-height:1.7\">Business Partner · الرياض — وصلتك لأنك مشترك في نشرتنا · المصادر رسمية، تحقّق قبل أي إجراء</div></div>`;return [{json:{html,subject:'📰 نشرة Business Partner الأسبوعية — '+today,count:items.length}}];"
      }
    },
