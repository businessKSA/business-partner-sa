    {
      "id": "614292cb-b390-4251-83ab-0718abf7d5fa",
      "name": "Match Existing Deal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const lead=$('Normalize Revenue Intake').first().json; const deals=$input.all().map(i=>i.json||{}).filter(d=>d.deal_id); const n=s=>String(s||'').trim().toLowerCase(); const dg=s=>String(s||'').replace(/\\D/g,''); const p=dg(lead.client_phone); const e=n(lead.client_email); const c=n(lead.client_name); const svc=n(lead.service); let found=null; if(p) found=deals.find(d=>{const x=dg(d.client_phone);return x&&((x===p)||(x.length>=9&&p.length>=9&&x.slice(-9)===p.slice(-9)));}); if(!found&&e) found=deals.find(d=>n(d.client_email)===e); if(!found&&c) found=deals.find(d=>n(d.client_name)===c&&(!svc||!d.service||n(d.service)===svc)); const now=new Date(); const y=now.getUTCFullYear(),m=String(now.getUTCMonth()+1).padStart(2,'0'),day=String(now.getUTCDate()).padStart(2,'0'); const newId=`DEAL-${y}${m}${day}-${lead.event_key.slice(-7).toUpperCase()}`; return [{json:{...lead,existing:!!found,deal_id:found?.deal_id||newId,current_stage:found?.stage||'',current_owner:found?.deal_owner||'',deal_value:Number(found?.deal_value||0),existing_notes:found?.notes||'',priority:found?.priority||'P2'}}];"
      }
    },
