    {
      "id": "5aea102e-3161-489e-a4c7-64f70be3c216",
      "name": "Normalize Revenue Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const b=$json.body||$json||{}; const clean=v=>String(v??'').trim(); const digits=v=>clean(v).replace(/\\D/g,''); const phone=digits(b.phone||b.client_phone||b.mobile||b.whatsapp); const email=clean(b.email||b.client_email).toLowerCase(); const client=clean(b.client_name||b.fullName||b.full_name||b.company||b.name); const service=clean(b.service||b.service_hint||b.request_type); const source=clean(b.source_channel||b.source||b.channel||'website').toLowerCase(); const message=clean(b.message||b.notes||b.details||b.request); const campaign=clean(b.source_campaign||b.campaign||b.utm_campaign); const honeypot=clean(b.website||b.hp||''); const supplied=clean(b.event_id||b.message_id||b.leadId||b.lead_id||b.idempotency_key); const basis=[source,phone,email,client.toLowerCase(),service.toLowerCase(),message].join('|'); let h=2166136261; for(let i=0;i<basis.length;i++){h^=basis.charCodeAt(i);h=Math.imul(h,16777619);} const event_key=(supplied||((h>>>0).toString(36))).replace(/[^A-Za-z0-9_-]/g,'').slice(0,64)||String(Date.now()); return {json:{client_name:client,client_phone:phone,client_email:email,service,source_channel:source,source_campaign:campaign,message,received_at:new Date().toISOString(),event_key,valid:!!(phone||email||client)&&!honeypot,honeypot}};"
      }
    },
