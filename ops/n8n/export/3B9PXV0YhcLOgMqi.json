      "parameters": {
        "jsCode": "var b = ($input.first().json || {}).body || {};\nvar t = String(b.text == null ? '' : b.text).trim();\nif (!t) { throw new Error('لا يوجد نص لنطقه'); }\nif (t.length > 2500) { t = t.slice(0, 2500); }\n// ALI (Hvlnv5DwiIO2CQ6oYMZ3) صوت مكتبة والـAPI يرفضه على الباقة المجانية.\n// الافتراضي صوت premade يعمل اليوم؛ يُعاد إلى ALI عند الترقية.\nvar v = String(b.voice_id == null ? '' : b.voice_id).trim();\nif (!v) { v = 'CwhRBWXzGAHq8TQ4Fs17'; }\nif (!/^[A-Za-z0-9]{16,32}$/.test(v)) { throw new Error('معرّف صوت غير صالح'); }\nvar m = String(b.model_id == null ? '' : b.model_id).trim();\nif (!m) { m = 'eleven_multilingual_v2'; }\nreturn [{ json: { text: t, voice_id: v, model_id: m } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
