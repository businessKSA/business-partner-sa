    {
      "id": "5ac674c5-dd0f-4f35-8e0b-d2016f04d01e",
      "name": "Decode Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        150,
        760
      ],
      "parameters": {
        "jsCode": "var b = ($input.first().json || {}).body || {};\nvar b64 = String(b.audio_b64 == null ? '' : b.audio_b64);\nvar comma = b64.indexOf('base64,');\nif (comma !== -1) { b64 = b64.slice(comma + 7); }\nif (!b64) { throw new Error('لا يوجد صوت في الطلب'); }\nvar buf = Buffer.from(b64, 'base64');\nif (buf.length < 800) { throw new Error('التسجيل قصير جداً'); }\nif (buf.length > 20000000) { throw new Error('التسجيل أكبر من الحد'); }\nvar mime = String(b.mime || 'audio/webm');\nvar name = mime.indexOf('mpeg') !== -1 ? 'clip.mp3' : (mime.indexOf('wav') !== -1 ? 'clip.wav' : 'clip.webm');\nvar bin = await this.helpers.prepareBinaryData(buf, name, mime);\nreturn [{ json: { bytes: buf.length, mime: mime }, binary: { audio: bin } }];",
        "language": "javaScript",
