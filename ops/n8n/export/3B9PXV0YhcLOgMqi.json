        "jsCode": "const rows=(n)=>{try{return $items(n).map(x=>x.json||{}).filter(x=>Object.keys(x).length)}catch(e){return[]}};\nreturn [{json:{\n  ok:true,\n  generated_at:new Date().toISOString(),\n  agents:rows('Read Agents'),\n  tasks:rows('Read Tasks'),\n  deals:rows('Read Deals'),\n  kpis:rows('Read KPIs'),\n  campaigns:rows('Read Campaigns'),\n  integrations:rows('Read Integrations')\n}}];"
