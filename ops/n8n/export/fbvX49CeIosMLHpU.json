    {
      "id": "9ca1415e-6c7d-4437-8fc0-4d598e8fa7e2",
      "name": "Find First Free Slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        1000
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const TZ_OFFSET_MS = 3 * 60 * 60 * 1000;\nconst events = $input.all().map(i => i.json);\nconst busy = events.filter(e => e.status !== 'cancelled' && e.start && e.start.dateTime && e.end && e.end.dateTime).map(e => ({ start: new Date(e.start.dateTime).getTime(), end: new Date(e.end.dateTime).getTime() }));\nconst SLOT_MIN = 30, DAY_START_H = 9, DAY_END_H = 17;\nlet slotStartMs = null;\nconst now = new Date();\nconst nowR = new Date(now.getTime() + TZ_OFFSET_MS);\nfor (let d = 1; d <= 10 && slotStartMs === null; d++) {\n  const day = new Date(Date.UTC(nowR.getUTCFullYear(), nowR.getUTCMonth(), nowR.getUTCDate() + d));\n  const wd = day.getUTCDay();\n  if (wd === 5 || wd === 6) continue;\n  for (let m = DAY_START_H * 60; m < DAY_END_H * 60; m += SLOT_MIN) {\n    const sR = day.getTime() + m * 60000;\n    const sU = sR - TZ_OFFSET_MS;\n    const eU = sU + SLOT_MIN * 60000;\n    if (!busy.some(b => sU < b.end && eU > b.start)) { slotStartMs = sU; break; }\n  }\n}\nconst page = $('Look Up Candidate').first().json;\nconst props = (page && page.properties) || {};\nconst name = (props['Candidate Name'] && props['Candidate Name'].title && props['Candidate Name'].title[0] && props['Candidate Name'].title[0].plain_text) || '';\nconst email = (props['Email'] && props['Email'].email) || '';\nconst jobTitle = (props['Target Job Title'] && props['Target Job Title'].rich_text && props['Target Job Title'].rich_text[0] && props['Target Job Title'].rich_text[0].plain_text) || '';\nconst client = (props['Client'] && props['Client'].rich_text && props['Client'].rich_text[0] && props['Client'].rich_text[0].plain_text) || '';\nreturn [{ json: { found: slotStartMs !== null, slotStartIso: slotStartMs !== null ? new Date(slotStartMs).toISOString() : null, slotEndIso: slotStartMs !== null ? new Date(slotStartMs + SLOT_MIN * 60000).toISOString() : null, candidateName: name, candidateEmail: email, targetJobTitle: jobTitle, client } }];\n"
      }
    },
