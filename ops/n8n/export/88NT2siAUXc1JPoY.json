      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const base = $('Merge org data').item.json;\nconst people = (($json && $json.people) || []).concat(($json && $json.contacts) || []);\nconst p = people.length ? people[0] : null;\nreturn { json: Object.assign({}, base, {\n  personId: p && p.id ? p.id : '',\n  personName: p && p.name ? p.name : '',\n  personTitle: p && p.title ? p.title : '',\n  personLinkedin: p && p.linkedin_url ? p.linkedin_url : ''\n}) };"
      }
