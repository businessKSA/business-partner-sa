    {
      "id": "07674325-25ff-481f-b696-ec04bc1e8e09",
      "name": "Merge org data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const base = $('Filter missing contact').item.json;\nconst org = ($json && $json.organization) ? $json.organization : {};\nreturn { json: Object.assign({}, base, {\n  phone: org.sanitized_phone || org.phone || base.phone || '',\n  linkedin: org.linkedin_url || base.linkedin || '',\n  employees: org.estimated_num_employees || null,\n  industry: org.industry || ''\n}) };"
      }
    },
