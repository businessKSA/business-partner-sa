        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const base = $('Pick decision maker').item.json;\nconst person = ($json && $json.person) ? $json.person : {};\nlet email = person.email || '';\nif (String(email).indexOf('not_unlocked') > -1) email = '';\nreturn { json: Object.assign({}, base, {\n  email: email,\n  personName: person.name || base.personName,\n  personTitle: person.title || base.personTitle,\n  personLinkedin: person.linkedin_url || base.personLinkedin\n}) };"
