    {
      "id": "e995222b-c583-4885-8fdd-8d5d8895f64b",
      "name": "Filter missing contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// All sectors: rows missing phone or email, with a domain.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const phone = j.property_phone || '';\n  const email = j.property_email || '';\n  let dom = j.property_domain || '';\n  if (!dom) continue;\n  if (phone && email) continue;\n  dom = String(dom).replace(/^https?:\\/\\//i, '').replace(/^www\\./i, '').split('/')[0].trim();\n  if (!dom) continue;\n  out.push({ json: {\n    pageId: j.id,\n    company: j.name || '',\n    domain: dom,\n    phone: phone,\n    email: email,\n    linkedin: j.property_linked_in || j.property_linkedin || ''\n  } });\n}\nreturn out;"
      }
    },
