      "name": "Build SSML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "// Region of the Azure Speech resource. Change here only.\nconst REGION = 'eastus2';\nconst b = ($input.first().json.body) || {};\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nlet text = esc(String(b.text || '').trim().slice(0, 900));\nif (!text) text = 'لا يوجد نص.';\nconst voice = /^[a-zA-Z-]+Neural$/.test(String(b.voice || '')) ? b.voice : 'ar-SA-ZariyahNeural';\nconst lang = voice.slice(0, 5);\nconst rate = /^[+-]?\\d{1,2}%$/.test(String(b.rate || '')) ? b.rate : '+0%';\nconst pitch = /^[+-]?\\d{1,2}%$/.test(String(b.pitch || '')) ? b.pitch : '+0%';\nconst xml = '<speak version=\"1.0\" xmlns=\"http://www.w3.org/2001/10/synthesis\" xml:lang=\"' + lang + '\"><voice name=\"' + voice + '\"><prosody rate=\"' + rate + '\" pitch=\"' + pitch + '\">' + text + '</prosody></voice></speak>';\nreturn [{ json: { ssml: xml, url: 'https://' + REGION + '.tts.speech.microsoft.com/cognitiveservices/v1', voice } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
