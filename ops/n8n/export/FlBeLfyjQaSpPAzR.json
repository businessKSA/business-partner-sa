        "language": "javaScript",
        "jsCode": "let V = {};\ntry { const v = $vars || {}; V = { GOSI_BASE_URL: v.GOSI_BASE_URL, GOSI_REG_NO: v.GOSI_REG_NO, GOSI_APIKEY: v.GOSI_APIKEY, GOSI_CLIENT_ID: v.GOSI_CLIENT_ID, GOSI_CLIENT_SECRET: v.GOSI_CLIENT_SECRET }; } catch (e) { V = {}; }\nconst body = ($input.first().json.body) || $input.first().json || {};\nconst baseUrl = String(V.GOSI_BASE_URL || 'https://sandbox-api.gosi.gov.sa').replace(/\\/$/, '');\nconst regNo = String(body.registration_number || body.reg || V.GOSI_REG_NO || '').trim();\nconst nin = String(body.nin || body.iqama || body.national_id || '').trim();\nif (!regNo) throw new Error('registration_number مفقود (أرسله في الطلب أو عرّف المتغير GOSI_REG_NO)');\nif (!nin) throw new Error('nin مفقود (NIN/Iqama/Border في جسم الطلب)');\nconst rand = Date.now().toString(36) + Math.random().toString(36).slice(2, 12);\nreturn [{ json: {\n  baseUrl, regNo, nin,\n  tokenUrl: baseUrl + '/v1/establishment/' + regNo + '/access-token',\n  contribUrl: baseUrl + '/v2/establishment/' + regNo + '/contributor/' + nin,\n  tokenJti: 'tok-' + rand,\n  contribJti: 'con-' + rand,\n  apikey: String(V.GOSI_APIKEY || ''),\n  clientId: String(V.GOSI_CLIENT_ID || ''),\n  clientSecret: String(V.GOSI_CLIENT_SECRET || ''),\n} }];"
      }
