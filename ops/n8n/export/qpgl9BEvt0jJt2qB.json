    {
      "id": "fa1d8016-1c58-4f2d-b002-ddd4a919b4cf",
      "name": "Count CVs All",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nlet read = 0, unread = 0, att = 0, noAtt = 0, oldest = null, newest = null;\nfor (const it of items) {\n  const j = it.json || {};\n  if (j.isRead === true) read++; else unread++;\n  if (j.hasAttachments === true) att++; else noAtt++;\n  const d = j.receivedDateTime || '';\n  if (d) { if (!oldest || d < oldest) oldest = d; if (!newest || d > newest) newest = d; }\n}\nreturn [{ json: { sampleSize: items.length, isRead_true: read, isRead_false: unread, hasAttachments_true: att, hasAttachments_false: noAtt, oldest, newest } }];"
      }
    },
