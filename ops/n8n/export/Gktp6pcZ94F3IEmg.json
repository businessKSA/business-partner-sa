        "jsCode": "const html=`<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"robots\" content=\"noindex,nofollow\"><title>Virtual Baher — Business Partner</title><style>:root{--gold:#d9b45b;--green:#27e6a5;--text:#eef7ff;--muted:#8ba4c7}*{box-sizing:border-box}html,body{margin:0;height:100%;background:radial-gradient(circle at 50% 35%,#092650 0,#031126 30%,#020817 65%,#01040b 100%);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Tahoma,Arial,sans-serif;overflow:hidden}body:before{content:'';position:fixed;inset:0;background-image:radial-gradient(#7ad8ff55 1px,transparent 1px),radial-gradient(#a368ff44 1px,transparent 1px);background-size:80px 80px,130px 130px;opacity:.24}.shell{height:100%;display:grid;grid-template-rows:72px 1fr;position:relative}.top{display:flex;align-items:center;justify-content:space-between;padding:0 22px;border-bottom:1px solid #1d4070;background:#031026dd}.brand{display:flex;align-items:center;gap:12px}.logo{width:42px;height:42px;border:1px solid var(--gold);border-radius:12px;display:grid;place-items:center;color:var(--gold);font-weight:900}.brand b{display:block;font-size:20px}.brand small{color:var(--gold);font-size:10px;letter-spacing:1.5px}.status{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px}.dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 14px var(--green)}.main{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:14px;padding:14px;min-height:0}.chat{min-height:0;background:linear-gradient(180deg,#061737d9,#030c1eea);border:1px solid #16477c;border-radius:22px;box-shadow:0 18px 80px #0008;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden}.hero{display:flex;align-items:center;gap:13px;padding:16px 18px;border-bottom:1px solid #12345d}.orb{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#62efff,#0c7ff0 35%,#073777 68%);border:1px solid #53ddff;box-shadow:0 0 30px #16bfff88,0 0 65px #3a68ff44;font-weight:900}.hero h1{font-size:19px;margin:0}.hero p{margin:4px 0 0;color:var(--muted);font-size:12px}.messages{min-height:0;overflow:auto;padding:20px 7%;scroll-behavior:smooth}.msg{max-width:78%;padding:13px 16px;border-radius:16px;margin:9px 0;white-space:pre-wrap;line-height:1.65;font-size:15px}.me{margin-right:auto;background:linear-gradient(135deg,#1769d7,#164aa6);border:1px solid #368cff}.ai{margin-left:auto;background:linear-gradient(135deg,#10274ff5,#191841f5);border:1px solid #465a9c}.thinking{opacity:.65}.composer{padding:13px 16px 16px;border-top:1px solid #12345d;background:#030c1ded}.inputwrap{display:flex;gap:8px;background:#07162d;border:1px solid #24588b;border-radius:18px;padding:8px}.inputwrap textarea{flex:1;resize:none;min-height:50px;max-height:150px;background:transparent;border:0;outline:0;color:#fff;font:inherit;padding:12px}.btn{width:48px;height:48px;border-radius:14px;border:1px solid #316999;background:#0a2448;color:#fff;font-size:20px}.send{background:linear-gradient(135deg,#007cc7,#4a54db)}.mic.on{background:#9b2865}.hints{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.hint{padding:7px 10px;border:1px solid #1b4774;border-radius:20px;color:#a8c4e8;font-size:11px;background:#07162a}.side{display:grid;grid-template-rows:auto 1fr auto;gap:12px;min-height:0}.card{background:#05122bc7;border:1px solid #174675;border-radius:18px;padding:14px}.card h3{margin:0 0 10px;font-size:14px}.metric,.person{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #173354}.metric span,.person small{color:var(--muted);font-size:11px}.person i{width:8px;height:8px;border-radius:50%;background:var(--green)}.team{overflow:auto}.foot{font-size:10px;color:#6e87a9;line-height:1.6}.error{color:#ff7f91}@media(max-width:900px){html,body{overflow:auto}.shell{min-height:100vh;height:auto}.top{padding:10px 12px}.status{display:none}.main{grid-template-columns:1fr;padding:7px}.side{display:none}.chat{height:calc(100vh - 86px);border-radius:16px}.messages{padding:14px 11px}.msg{max-width:91%;font-size:14px}.hero{padding:12px}.orb{width:44px;height:44px}.hero h1{font-size:16px}.composer{padding:9px}.hints{overflow:auto;flex-wrap:nowrap}.hint{white-space:nowrap}}</style></head><body><div class=\"shell\"><header class=\"top\"><div class=\"brand\"><div class=\"logo\">BP</div><div><b>Business Partner</b><small>AI COMMAND CENTER</small></div></div><div class=\"status\"><span class=\"dot\"></span> Virtual Baher Online · Riyadh</div></header><main class=\"main\"><section class=\"chat\"><div class=\"hero\"><div class=\"orb\">VB</div><div><h1>باهر الافتراضي · Virtual Baher</h1><p>تكلم طبيعي. أنا أقرأ الفريق، المهام، الصفقات والمالية وأرتب لك الشغل.</p></div></div><div class=\"messages\" id=\"messages\"><div class=\"msg ai\">هلا باهر 👋\\nأنا معك. قل لي أي شيء طبيعي — «وش علي اليوم؟»، «كم الـPipeline؟»، أو «فلان كلمني ويبغى خدمة» — وأنا أرتب الباقي.</div></div><div class=\"composer\"><div class=\"inputwrap\"><button class=\"btn mic\" id=\"mic\">🎙️</button><textarea id=\"input\" autofocus placeholder=\"اكتب أو تكلم...\"></textarea><button class=\"btn send\" id=\"send\">➤</button></div><div class=\"hints\"><button class=\"hint\">وش علي اليوم؟</button><button class=\"hint\">كم الإيرادات المتوقعة؟</button><button class=\"hint\">مين دفع ولسه ما نفذنا؟</button><button class=\"hint\">وش أسرع شيء يدخل فلوس اليوم؟</button></div></div></section><aside class=\"side\"><div class=\"card\"><h3>⚡ الوضع التنفيذي</h3><div class=\"metric\"><span>واجهة التشغيل</span><b style=\"color:var(--green)\">LIVE</b></div><div class=\"metric\"><span>المصدر</span><b>Tasks + Deals</b></div><div class=\"metric\"><span>المالية</span><b>Ledger + Deals</b></div><div class=\"metric\"><span>الأولوية</span><b>Cash First</b></div></div><div class=\"card team\"><h3>🛰️ الفريق التنفيذي</h3><div class=\"person\"><div><b>فرح</b><small>Marketing</small></div><i></i></div><div class=\"person\"><div><b>بدر</b><small>Sales & BD</small></div><i></i></div><div class=\"person\"><div><b>عبدالرحمن</b><small>Finance</small></div><i></i></div><div class=\"person\"><div><b>عبدالعزيز</b><small>Legal</small></div><i></i></div><div class=\"person\"><div><b>مازن</b><small>Operations</small></div><i></i></div><div class=\"person\"><div><b>محمد</b><small>IT</small></div><i></i></div></div><div class=\"card foot\">الأرقام من البيانات المسجلة فقط. رصيد البنك الفعلي يظهر بعد ربط البنك/المحاسبة.</div></aside></main></div><script>const endpoint='/webhook/virtual-baher-live-R9k7Tm2QxL5Vn8Pz-chat',input=document.getElementById('input'),messages=document.getElementById('messages'),send=document.getElementById('send'),mic=document.getElementById('mic');let busy=false,session=localStorage.getItem('vb_session');if(!session){session='baher-'+Date.now();localStorage.setItem('vb_session',session)}function bubble(text,who,extra=''){const d=document.createElement('div');d.className='msg '+who+' '+extra;d.textContent=text;messages.appendChild(d);messages.scrollTop=messages.scrollHeight;return d}async function talk(text){text=(text||'').trim();if(!text||busy)return;busy=true;bubble(text,'me');input.value='';const wait=bubble('أفحص النظام وأرتب لك...','ai','thinking');try{const r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text,session_id:session})});const data=await r.json();wait.remove();bubble(data.reply||'تم، لكن ما رجعت نتيجة واضحة.','ai')}catch(e){wait.remove();bubble('صار خطأ في الاتصال. جرّب مرة ثانية.','ai error')}finally{busy=false;input.focus()}}send.onclick=()=>talk(input.value);input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();talk(input.value)}});document.querySelectorAll('.hint').forEach(b=>b.onclick=()=>talk(b.textContent));const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR){const rec=new SR();rec.lang='ar-SA';rec.onstart=()=>mic.classList.add('on');rec.onend=()=>mic.classList.remove('on');rec.onresult=e=>talk(e.results[0][0].transcript);mic.onclick=()=>{try{rec.start()}catch(e){}}}else{mic.onclick=()=>bubble('الصوت من هذا المتصفح غير مدعوم؛ اكتب هنا أو استخدم مُعين على واتساب.','ai')}</script></body></html>`;return[{json:{html}}];"
