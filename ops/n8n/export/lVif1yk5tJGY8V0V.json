        "jsCode": "const p=$('Prep').first().json;const tenantId=$('Create Tenant Page').first().json.id;const tasksId=$('Create Tasks DB').first().json.id;const convId=$input.first().json.id;const registerBody=JSON.stringify({parent:{type:'database_id',database_id:'39fd108dee5c81328a17cfe65d281688'},properties:{'العميل':{title:[{text:{content:p.name}}]},'الإيميل':{email:p.email},'الرمز':{rich_text:[{text:{content:p.code}}]},'الحالة':{select:{name:'نشط'}},TenantPage:{rich_text:[{text:{content:tenantId}}]},TasksDB:{rich_text:[{text:{content:tasksId}}]},ConvDB:{rich_text:[{text:{content:convId}}]}}});const emailText='أهلاً '+p.name+'،\\n\\nتم تجهيز فريقك التنفيذي الذكي بنجاح ✅\\n\\nرمز الدخول الخاص بك: '+p.code+'\\n\\nادخل بوابة الخدمة وأدخل الرمز لفتح لوحتك:\\nhttps://www.businesspartner.sa/ar/shared-services/dashboard\\n\\nهذا الرمز خاص بك — لا تشاركه مع أي أحد. فريقنا لا يطلب كلمات مرور أو رموز تحقق أبداً.\\n\\nBusiness Partner';const respondBody=JSON.stringify({ok:true,code:p.code,client:p.name,portal:'https://www.businesspartner.sa/ar/shared-services/dashboard'});return [{json:{registerBody:registerBody,emailText:emailText,respondBody:respondBody}}];"
