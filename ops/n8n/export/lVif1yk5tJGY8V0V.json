        "language": "javaScript",
        "jsCode": "const t=$input.first().json.id;const tasksBody=JSON.stringify({parent:{type:'page_id',page_id:t},icon:{type:'emoji',emoji:'📝'},title:[{type:'text',text:{content:'المهام — Tasks'}}],properties:{'المهمة':{title:{}},'الوكيل المسؤول':{rich_text:{}},'الحالة':{select:{options:[{name:'جديدة',color:'gray'},{name:'قيد التنفيذ',color:'blue'},{name:'بانتظار اعتماد',color:'orange'},{name:'منجزة',color:'green'}]}},'الملخص':{rich_text:{}},'التاريخ':{created_time:{}}}});const convBody=JSON.stringify({parent:{type:'page_id',page_id:t},icon:{type:'emoji',emoji:'💬'},title:[{type:'text',text:{content:'المحادثات — Conversations'}}],properties:{'العنوان':{title:{}},'الوكيل':{rich_text:{}},'الرسالة':{rich_text:{}},'الرد':{rich_text:{}},'التاريخ':{created_time:{}}}});return [{json:{tenantId:t,tasksBody:tasksBody,convBody:convBody}}];"
