    {
      "id": "5395f68a-dd46-4289-9d9d-78b3a1f4a4bf",
      "name": "Best email per company",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const map = {};\nfor (const r of $input.all()) {\n  const j = r.json;\n  const id = j.pageId;\n  if (!id) continue;\n  if (!(id in map)) map[id] = { email: '', domain: j.domain || '' };\n  if (!map[id].email && j.email) map[id].email = j.email;\n  if (!map[id].domain && j.domain) map[id].domain = j.domain;\n}\nconst out = [];\nfor (const id in map) {\n  let e = map[id].email;\n  if (!e && map[id].domain) e = 'info@' + map[id].domain; // generic fallback for companies with a website\n  if (e) out.push({ json: { pageId: id, email: e } });\n}\nreturn out;"
      }
    }
