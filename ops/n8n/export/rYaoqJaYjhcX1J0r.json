    },
    {
      "id": "881c71f6-fcae-402b-a26d-26e33263e6fe",
      "name": "Extract email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const resp = $json || {};\nconst base = $('Find rows to scan').item.json;\nlet html = '';\nif (typeof resp.data === 'string') html = resp.data;\nelse if (typeof resp.body === 'string') html = resp.body;\nelse html = JSON.stringify(resp);\nconst re = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g;\nconst found = html.match(re) || [];\nconst bad = /(\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.svg|\\.js|\\.css|sentry|wixpress|godaddy|example\\.com|@2x|@3x)/i;\nconst clean = [];\nfor (let e of found) { e = e.toLowerCase(); if (bad.test(e)) continue; if (clean.indexOf(e) < 0) clean.push(e); }\nconst dom = String(base.domain || '').toLowerCase();\nlet pick = clean.find(function(e){ return dom && e.split('@')[1] === dom; });\nif (!pick) pick = clean.find(function(e){ return /^(info|sales|contact|hello|admin|support|marketing|business)@/.test(e); });\nif (!pick) pick = clean[0] || '';\nreturn { json: { pageId: base.pageId, email: pick, domain: dom } };"
      }
    },
    {
      "id": "90be9fb3-8557-4d0e-a0e4-83f1281cb6ee",
      "name": "Has email?",
