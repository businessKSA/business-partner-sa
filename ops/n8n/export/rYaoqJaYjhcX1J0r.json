    {
      "id": "e41a5c7b-a5ea-4b86-9918-b3398cacef42",
      "name": "Find rows to scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all();\nconst out = [];\nlet n = 0;\nfor (const r of rows) {\n  const j = r.json;\n  const email = j.property_email || '';\n  let dom = j.property_domain || '';\n  if (email) continue;\n  if (!dom) continue;\n  let base = String(dom).trim();\n  if (!/^https?:\\/\\//i.test(base)) base = 'https://' + base;\n  base = base.replace(/\\/+$/, '');\n  const host = base.replace(/^https?:\\/\\//i, '').replace(/^www\\./i, '').split('/')[0];\n  const paths = ['', '/contact', '/contact-us', '/contactus', '/ar/contact', '/about'];\n  for (const p of paths) out.push({ json: { pageId: j.id, domain: host, url: base + p } });\n  n++;\n  if (n >= 10) break;\n}\nreturn out;"
      }
    },
    {
