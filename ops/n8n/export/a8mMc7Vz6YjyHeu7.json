    {
      "id": "d59f2ac5-1625-40fd-9b4f-aaa29abe06e9",
      "name": "Build Pulse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const agg = $('Aggregate Tasks').first().json || { agents: {}, task_rows: 0 };\nconst agents = agg.agents || {};\nconst reg = $input.all().map(i => i.json).filter(r => r && r.agent_id);\nfor (const r of reg) {\n  const id = String(r.agent_id).trim();\n  const a = agents[id] || (agents[id] = { open: 0, in_progress: 0, queued: 0, last_update: null, latest_objective: '' });\n  a.enabled = r.enabled;\n  a.status = r.status || null;\n  a.autonomy_level = r.autonomy_level || null;\n  a.registry_updated_at = r.updated_at || null;\n  for (const k of Object.keys(r)) { if (/heartbeat/i.test(k)) a[k] = r[k]; }\n}\nlet inProg = 0, open = 0;\nfor (const k of Object.keys(agents)) { inProg += agents[k].in_progress || 0; open += agents[k].open || 0; }\nreturn [{ json: { ok: true, at: new Date().toISOString(), agents, totals: { open, in_progress: inProg }, sources: { task_rows: agg.task_rows || 0, registry_rows: reg.length } } }];"
      }
    },
