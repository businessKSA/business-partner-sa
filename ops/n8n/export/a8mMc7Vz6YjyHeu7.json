      "id": "d2dfadb1-a3df-4979-a657-29c1626745d9",
      "name": "Aggregate Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.task_id);\nconst agents = {};\nfor (const r of rows) {\n  const id = String(r.assigned_to_agent || '').trim();\n  if (!id) continue;\n  const a = agents[id] || (agents[id] = { open: 0, in_progress: 0, queued: 0, last_update: null, latest_objective: '' });\n  a.open += 1;\n  if (r.status === 'in_progress') a.in_progress += 1; else a.queued += 1;\n  const u = r.updated_at || r.created_at || null;\n  if (u && (!a.last_update || String(u) > String(a.last_update))) { a.last_update = u; a.latest_objective = String(r.objective || '').slice(0, 120); }\n}\nreturn [{ json: { agents, task_rows: rows.length } }];"
      }
    },
