      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst byType = {};\nlet inline = 0, notInline = 0, errors = 0, total = 0, bytes = 0;\nfor (const it of items) {\n  const j = it.json || {};\n  if (j.error) { errors++; continue; }\n  if (!j.contentType && !j.size && j.isInline === undefined) continue;\n  total++;\n  const t = String(j.contentType || 'unknown');\n  byType[t] = (byType[t] || 0) + 1;\n  if (j.isInline === true) inline++; else notInline++;\n  bytes += Number(j.size) || 0;\n}\nreturn [{ json: { rawItems: items.length, attachmentsFound: total, isInline_true: inline, isInline_false: notInline, errorItems: errors, totalBytes: bytes, byContentType: byType } }];"
      }
    }
