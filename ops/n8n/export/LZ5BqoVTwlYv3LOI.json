      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const task=$('Read Queued Team Tasks').item.json||{}; const ctrl=$json||{}; const map={badr_sales:'nvrh0c3mUctb1EsG',mazen_ops:'WZE7oUzCzQGR1u0t',mohammed_it:'e9G9S6GG0j7lCiWt',website_funnel_ops:'8HL5NWvqi1SkTKqb',abdulrahman_finance:'HZ8W430gZovbVSSs',abdulaziz_legal:'SL1aYYS2UBsqHFPE',mishari_compliance:'milR3qpw3c9Li5xN',nasser_hr:'c7WRFI1UmoQ4noM5',farah_marketing:'vWICtJIGL4Cu7NXy',abdullah_procurement:'8PGiUitiRKDybt3l',ahmed_strategy:'BZlZ9irajglk4qpS'}; const parent=String(ctrl.reports_to||''); const directId=map[task.assigned_to_agent]||''; const workflowId=directId||map[parent]||''; const routedVia=directId?task.assigned_to_agent:parent; const controlStatus=String(ctrl.status||'').toLowerCase(); const explicitlyDisabled=ctrl.enabled===false||['paused','maintenance','disabled','offline'].includes(controlStatus); const humanBlocked=task.assigned_to_agent==='baher_owner'||task.human_action_required===true||(task.approval_required===true&&String(task.approval_status||'').toLowerCase()!=='approved'); const dispatch=!!workflowId&&!humanBlocked&&!explicitlyDisabled; let reason='ready'; if(humanBlocked)reason='human_or_approval_gate'; else if(explicitlyDisabled)reason='agent_paused'; else if(!workflowId)reason='unknown_agent_or_manager'; const message='INTERNAL ASSIGNED TASK '+(task.task_id||'')+'\\nAssigned employee: '+(task.assigned_to_agent||'')+'\\nRouted via manager: '+routedVia+'\\nObjective: '+(task.objective||'')+'\\nContext: '+(task.context||'')+'\\nPriority: '+(task.priority||'')+'\\nCash stage: '+(task.cash_stage||'')+'\\nRevenue SAR: '+(task.revenue_value||0)+'\\nNext action: '+(task.next_action||'')+'\\nDue: '+(task.due_at||'')+'\\nAutonomy: '+(ctrl.autonomy_level||ctrl.permissions_level||'L2')+'\\nExecute within your allowed tools. If the assigned employee is one of your specialists, delegate to that specialist. Return a concise result and exact next action.'; return {json:{...task,dispatch,workflow_id:workflowId,dispatch_reason:reason,routed_via_manager:routedVia,message,channel:'internal',agent_alias:'',agent_control:{enabled:ctrl.enabled!==false,status:ctrl.status||'active',autonomy_level:ctrl.autonomy_level||ctrl.permissions_level||'',health_status:ctrl.health_status||'unknown',reports_to:parent}}};"
      }
