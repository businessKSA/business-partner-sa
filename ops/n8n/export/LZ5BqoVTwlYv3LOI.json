    {
      "id": "d0268e04-2a2a-447f-9f63-62f9d3b0e179",
      "name": "Skip Human & Loop Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        180
      ],
      "parameters": {
        "jsCode": "// Tasks that cannot be dispatched must not occupy the 2 slots of a tick.\n// Human/approval-gated tasks stay queued (they dispatch once approved) but are\n// skipped here; recirculation chains (-RECIRC-2 and deeper) are the\n// self-assignment loop closed on 2026-09-23 and are never dispatched.\nconst out = [];\n$input.all().forEach((it, i) => {\n  const t = it.json || {};\n  const human = t.assigned_to_agent === 'baher_owner' || t.human_action_required === true ||\n    (t.approval_required === true && String(t.approval_status || '').toLowerCase() !== 'approved');\n  const loop = /-RECIRC-([2-9]|\\d{2,})$/.test(String(t.task_id || ''));\n  if (!human && !loop) out.push({ json: t, pairedItem: i });\n});\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
