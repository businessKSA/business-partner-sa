      "position": [
        680,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.key }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $env.BP_CHAT_MEDIA_KEY }}"
            },
            {
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
