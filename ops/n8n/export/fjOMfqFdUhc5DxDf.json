      "name": "POST Send Media",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        400
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bp-chat-media-x7k2m9",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "4b91e497-f855-4770-ad13-bf65b7398c1b"
    },
    {
      "id": "2d9fd002-558c-4f84-8164-0f54067d5c24",
      "name": "Parse Media Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ],
      "parameters": {
        "jsCode": "let b = $json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nconst phone = String(b.phone || '').replace(/[^0-9]/g, '');\nlet mt = String(b.mediatype || 'document');\nif (mt !== 'image' && mt !== 'document') mt = 'document';\nlet media = String(b.media || '');\nconst comma = media.indexOf(',');\nif (media.slice(0, 5) === 'data:' && comma > -1) media = media.slice(comma + 1);\nconst keyOk = String(b.key || '') === String($env.BP_CHAT_MEDIA_KEY || '');\nconst valid = keyOk && phone.length >= 9 && media.length > 0;\nreturn [{ json: { key: String(b.key || ''), phone: phone, mediatype: mt, filename: String(b.filename || 'file'), caption: String(b.caption || ''), mime: String(b.mime || (mt === 'image' ? 'image/jpeg' : 'application/octet-stream')), media: media, valid: valid } }];"
      }
    },
    {
      "id": "c789d022-cf0b-40db-9da6-1a088dad5325",
      "name": "Media Key Valid?",
      "type": "n8n-nodes-base.if",
