      "id": "a398f765-2d87-42a6-b8d8-de23bac2593c",
      "name": "Prepare Email Data1"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json;\n\nconst from = input.from || \"\";\nconst senderEmail = input.senderEmail || \"\";\n\nlet name = \"\";\nlet email = senderEmail || \"\";\nlet company = \"\";\n\n// Extract name from: \"Respond.io\" <no-reply@mail.respond.io>\nif (from) {\n  name = from.replace(/<.*?>/g, \"\").replace(/[\"\\\\]/g, \"\").trim();\n}\n\n// Extract email from angle brackets if needed\nif (!email && from.includes(\"<\") && from.includes(\">\")) {\n  const match = from.match(/<([^>]+)>/);\n  email = match ? match[1] : \"\";\n}\n\n// Extract company from email domain\nif (email.includes(\"@\")) {\n  const domain = email.split(\"@\")[1] || \"\";\n  const personalDomains = [\"gmail.com\", \"hotmail.com\", \"outlook.com\", \"yahoo.com\", \"icloud.com\"];\n\n  if (!personalDomains.includes(domain.toLowerCase())) {\n    const parts = domain.split(\".\");\n    company = parts.length >= 3 ? parts[1] : parts[0];\n  }\n}\n\nreturn {\n  json: {\n    name: name || email || \"Unknown Contact\",\n    email: email || \"\",\n    phone: \"\",\n    company: company || \"Unknown\",\n    sourceEmailId: input.emailId || \"\",\n    sourceThreadId: input.threadId || \"\",\n    source: \"Gmail\"\n  }\n};"
      },
