    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and classify it.\n\nSubject: {{ $json.subject }}\nFrom: {{ $json.from.text }}\nTo: {{ $json.to.text }}\nCC: {{ $json.cc?.text || \"None\" }}\nDate: {{ $json.date }}\nBody: {{ $json.text || $json.textAsHtml }}\n\nClassify into one or more labels:\n- BP/Company Formation\n- BP/Foreign Investment\n- BP/Premium Residency\n- BP/Recruitment\n- BP/GRO\n- BP/HR Services\n- BP/Tourism\n- BP/Medical Tourism\n- BP/Finance\n- BP/Invoices\n- BP/Quotations\n- BP/Contracts\n- BP/Government\n- BP/Partners\n- BP/Suppliers\n- BP/Internal\n- BP/Urgent\n- BP/Follow Up\n- BP/Waiting Client\n- BP/Completed\n- BP/Uncategorized\n\nProvide:\n1. labels: array of applicable labels\n2. summary: brief summary\n3. actionRequired: true/false\n4. priority: \"low\", \"medium\", or \"high\"\n5. taskName: if action required, what task\n6. dueDate: suggested due date (ISO format)\n7. contacts: extract all people mentioned (name, email, phone, company)\n8. companies: extract all companies mentioned (name, domain, country, industry)",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert email classifier for a business services company. Analyze emails and extract structured information accurately."
        }
      },
      "id": "71f7a3ea-3090-4b3e-8f29-6fe4ac34b748",
      "name": "AI Email Classifier",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        912,
        832
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"labels\":[\"BP/Company Formation\",\"BP/Urgent\"],\"summary\":\"Brief summary of the email\",\"actionRequired\":true,\"priority\":\"high\",\"taskName\":\"Follow up on quotation request\",\"dueDate\":\"2024-01-20\",\"contacts\":[{\"name\":\"John Doe\",\"email\":\"john@example.com\",\"phone\":\"+1234567890\",\"company\":\"Example Corp\"}],\"companies\":[{\"name\":\"Example Corp\",\"domain\":\"example.com\",\"country\":\"UAE\",\"industry\":\"Technology\"}]}"
      },
