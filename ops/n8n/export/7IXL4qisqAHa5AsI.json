    {
      "parameters": {
        "jsCode": "const ai = $json.output || $json;\n\n// Get original email data from the current item first.\n// If not available, fallback to Merge Email Sources.\nlet email = $json;\n\ntry {\n  const mergeItems = $(\"Merge Email Sources\").all();\n  if (mergeItems.length > 0) {\n    email = mergeItems[0].json;\n  }\n} catch (e) {\n  email = $json;\n}\n\nconst subject =\n  email.subject ||\n  email.Subject ||\n  ai.summary ||\n  \"No Subject\";\n\nconst emailId =\n  email.id ||\n  email.emailId ||\n  email.messageId ||\n  null;\n\nconst threadId =\n  email.threadId ||\n  email.thread_id ||\n  emailId ||\n  null;\n\nreturn [\n  {\n    json: {\n      subject,\n      threadName: subject,\n      emailId,\n      threadId,\n\n      from: email.from?.text || email.from || \"\",\n      senderEmail: email.from?.value?.[0]?.address || email.from?.text || \"\",\n      to: email.to?.text || email.to || \"\",\n      cc: email.cc?.text || email.cc || \"\",\n      bcc: email.bcc?.text || email.bcc || \"\",\n      date: email.date || new Date().toISOString(),\n      body: email.text || email.html || email.body || \"\",\n\n      labels: ai.labels || [\"BP/Uncategorized\"],\n      summary: ai.summary || \"No summary available\",\n      actionRequired: ai.actionRequired || false,\n      priority: ai.priority || \"medium\",\n      taskName: ai.taskName || \"\",\n      dueDate: ai.dueDate || \"\",\n      contacts: ai.contacts || [],\n      companies: ai.companies || []\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
