    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const currentLabel = $json.labels?.[0] || $json.labelName || \"BP/Uncategorized\";\n\nconst allLabelItems = $(\"Get All Gmail Labels\").all();\n\nconst existingLabel = allLabelItems.find(item => {\n  return item.json.name === currentLabel;\n});\n\nreturn {\n  json: {\n    ...$json,\n    labelName: currentLabel,\n    labelExists: !!existingLabel,\n    labelId: existingLabel ? existingLabel.json.id : null,\n    emailId: $json.emailId || $json.messageId || null\n  }\n};"
      },
