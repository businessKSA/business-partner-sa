    {
      "id": "9a36fe42-a033-4480-bfdd-7d88c5142143",
      "name": "Parse Suggest Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "let b = $json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nconst phone = String(b.phone || '').replace(/[^0-9]/g, '');\nconst lang = (String(b.lang || 'ar').toLowerCase() === 'en') ? 'en' : 'ar';\nconst instruction = String(b.instruction || '').trim();\nconst keyOk = String(b.key || '') === String($env.BP_CHAT_MEDIA_KEY || '');\nconst valid = keyOk && phone.length >= 9;\nreturn [{ json: { key: String(b.key||''), phone: phone, lang: lang, instruction: instruction, valid: valid } }];"
      }
    },
    {
      "id": "bc3a2c91-4bb1-4fc8-805f-fab412ca3274",
      "name": "Suggest Key Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
