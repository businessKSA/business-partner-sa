    {
      "id": "47204f6d-8aa2-4f56-be53-d20f9e689da1",
      "name": "Format Suggestion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        220
      ],
      "parameters": {
        "jsCode": "const j = $json || {};\nlet reply = '';\nif (typeof j.text === 'string') reply = j.text;\nelse if (typeof j.output_text === 'string') reply = j.output_text;\nelse if (typeof j.content === 'string') reply = j.content;\nelse if (Array.isArray(j.content)) reply = j.content.map(function(c){ return (c && c.text) || ''; }).join('');\nelse if (j.message && typeof j.message.content === 'string') reply = j.message.content;\nelse if (j.message && Array.isArray(j.message.content)) reply = j.message.content.map(function(c){ return (c && c.text) || ''; }).join('');\nelse if (j.choices && j.choices[0] && j.choices[0].message) reply = j.choices[0].message.content || '';\nelse if (Array.isArray(j.output)) { for (const it of j.output) { if (it && Array.isArray(it.content)) { for (const c of it.content) { if (c && c.text) reply += c.text; } } } }\nelse if (typeof j.completion === 'string') reply = j.completion;\nreply = String(reply || '').trim();\nlet lang = 'ar'; try { lang = $('Build Prompt').first().json.lang; } catch(e){}\nif (!reply) return [{ json: { ok: false, reply: '', error: 'no_text', lang: lang } }];\nreturn [{ json: { ok: true, reply: reply, lang: lang } }];"
      }
    },
