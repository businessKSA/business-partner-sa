    {
      "id": "5192aa42-2911-4c72-b273-dfdbb7f127ec",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        220
      ],
      "parameters": {
        "jsCode": "const meta = $('Parse Suggest Request').first().json;\nconst lang = meta.lang === 'en' ? 'en' : 'ar';\nconst instruction = meta.instruction || '';\nconst rows = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const p = j.properties || {};\n  function seg(prop){ const s=p[prop]||{}; const a=s.rich_text||s.title||[]; let o=''; for(const x of a) o+=(x.plain_text||''); return o; }\n  const sender = (p['المرسل'] && p['المرسل'].select && p['المرسل'].select.name) || '';\n  const text = seg('الرسالة') || seg('العنوان');\n  const time = j.created_time || '';\n  if (sender === 'تنبيه') continue;\n  if (!text) continue;\n  rows.push({ time: time, sender: sender, text: text });\n}\nrows.sort(function(a,b){ return new Date(a.time) - new Date(b.time); });\nconst recent = rows.slice(-20);\nconst label = { 'العميل':'Customer', 'الوكيل الذكي':'Agent', 'المالك':'Owner (you)' };\nconst transcript = recent.map(function(r){ return (label[r.sender]||r.sender) + ': ' + r.text; }).join('\\n');\nconst system = lang === 'en'\n  ? 'You are a senior sales agent for Business Partner, a Saudi business-services company. Draft the NEXT reply the human owner should send to the customer on WhatsApp. Be warm, professional, concise and consultative. For pricing, direct them to the relevant service page instead of quoting numbers. Never invent prices or facts. Output ONLY the reply text, no preamble, in English.'\n  : 'أنت مندوب مبيعات محترف لشركة Business Partner. اكتب الرد التالي الذي يرسله المالك للعميل على واتساب. كن ودوداً واحترافياً ومختصراً ومستشاراً. أي سؤال عن الأسعار وجّهه لصفحة الخدمة في الموقع بدون ذكر أرقام. لا تخترع أسعاراً أو معلومات. اكتب نص الرد فقط بدون مقدمة، بالعربية.';\nconst user = (transcript || '(no messages yet)') + (instruction ? ('\\n\\ninstruction: ' + instruction) : '') + '\\n\\nWrite the next reply now.';\nreturn [{ json: { system: system, user: user, lang: lang } }];"
      }
    },
