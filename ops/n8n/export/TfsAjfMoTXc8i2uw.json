    {
      "id": "542ac580-9493-408f-8364-32efe300c971",
      "name": "🏗️ بناء السجل + السيرة",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "let parsed = {}; let llmError = false;\nconst c = $json;\nif (c && c.error) { llmError = true; }\ntry {\n  let txt = '{}';\n  if (typeof c.content === 'string') txt = c.content;\n  else if (c.content && c.content[0] && c.content[0].text) txt = c.content[0].text;\n  else if (c.message && typeof c.message.content === 'string') txt = c.message.content;\n  else if (c.choices && c.choices[0] && c.choices[0].message) txt = c.choices[0].message.content;\n  else if (typeof c.text === 'string') txt = c.text;\n  else if (typeof c.output === 'string') txt = c.output;\n  const fence = String.fromCharCode(96,96,96);\n  txt = txt.split(fence + 'json').join('').split(fence).join('').trim();\n  parsed = JSON.parse(txt);\n} catch (e) { parsed = {}; }\nconst meta = $('🧹 توحيد + انتقاء CV').item.json;\nlet cvText = ''; try { cvText = ($('📄 استخراج نص PDF').item.json.text || '').toString().trim(); } catch(e) {}\nconst FIELDS = [\"هندسة\",\"تقنية معلومات\",\"مبيعات وتسويق\",\"محاسبة ومالية\",\"إداري وسكرتارية\",\"موارد بشرية\",\"ضيافة ومطاعم\",\"مقاولات وإنشاءات\",\"صحة وطب\",\"تعليم\",\"لوجستيات ونقل\"];\nconst EDU = [\"ثانوي\",\"دبلوم\",\"بكالوريوس\",\"ماجستير\",\"دكتوراه\"];\nconst NAT = [\"سعودي\",\"غير سعودي\"];\nconst LANGS = [\"العربية\",\"الإنجليزية\"];\nconst SAUD = [\"مقصورة على السعوديين\",\"نسبة توطين + اشتراطات\",\"مسموح لغير السعوديين\",\"بحاجة فحص\"];\nconst COMP = [\"✅ مطابق\",\"⛔ مهنة سعودية - غير سعودي\",\"⚠️ اشتراطات\",\"🔍 بحاجة فحص\"];\nconst DEC = [\"Yes\",\"No\",\"Needs Review\",\"غير محدد\"];\nconst pick = (v, allow, dflt) => allow.indexOf(v) >= 0 ? v : dflt;\nconst s = (v) => (v === null || v === undefined) ? '' : String(v);\nconst nn = (v) => { const x = s(v).trim(); return x ? x : null; };\nconst langsIn = Array.isArray(parsed.languages) ? parsed.languages.filter(x => LANGS.indexOf(x) >= 0) : [];\nconst nameAr = s(parsed.name_ar).trim(); const nameEn = s(parsed.name_en).trim();\nconst realName = nameAr || nameEn;\nconst fieldVal = pick(s(parsed.field), FIELDS, \"\");\nconst emailV = nn(parsed.email); const phoneV = nn(parsed.phone);\nlet hidden = false; let readStatus = 'مكتمل'; let reason = '';\nconst missing = [];\nif (!realName) missing.push('الاسم');\nif (!fieldVal) missing.push('المجال');\nif (!emailV && !phoneV) missing.push('وسيلة تواصل');\nif (cvText.length < 30) { hidden = true; readStatus = 'غير مقروء - PDF مصور'; reason = 'ملف PDF مصوّر (صورة) بدون نص قابل للاستخراج — يحتاج OCR ليُقرأ.'; }\nelse if (llmError || Object.keys(parsed).length === 0) { hidden = true; readStatus = 'فشل التحليل'; reason = 'تعذّر تحليل الملف عبر الذكاء الاصطناعي (خطأ مؤقت) — يُعاد لاحقاً.'; }\nelse if (missing.length) { hidden = true; readStatus = 'ناقص - بيانات غير كافية'; reason = 'بيانات ناقصة: ' + missing.join('، '); }\nconst title = realName || ('[غير مقروء] ' + (s(meta.subject) || s(meta.cvFileName) || 'سيرة'));\nconst atsFull = s(parsed.ats_cv_markdown) || s(parsed.summary);\nconst ats = hidden ? ('⚠️ لم تُبنَ سيرة ATS. السبب: ' + reason) : atsFull;\nconst chunks = [];\nfor (let i = 0; i < 8; i++) { const part = ats.slice(i*1800, (i+1)*1800); if (part) chunks.push(part); }\nwhile (chunks.length < 6) chunks.push('');\nconst folderName = (title + ' — ' + nameEn).slice(0, 90).trim();\nconst notes = 'استيراد من Outlook | ' + s(meta.subject) + ' | من: ' + s(meta.from) + ' | ' + s(meta.date);\nreturn { json: {\n  is_candidate: hidden ? true : (parsed.is_candidate !== false),\n  hidden, read_status: readStatus, reason,\n  name_ar: title, name_en: nameEn, email: emailV, phone: phoneV,\n  city: s(parsed.city), nationality: s(parsed.nationality),\n  nationality_type: pick(s(parsed.nationality_type), NAT, ''),\n  field: fieldVal,\n  target_role: s(parsed.target_role), original_position: s(parsed.original_position),\n  experience_years: Number(parsed.experience_years) || 0,\n  education: pick(s(parsed.education), EDU, ''),\n  languages: langsIn, languages_str: langsIn.join(', '), skills: s(parsed.skills),\n  expected_salary: (parsed.expected_salary === null || parsed.expected_salary === undefined || parsed.expected_salary === \"\") ? 0 : (Number(parsed.expected_salary) || 0),\n  summary: s(parsed.summary),\n  saudization: pick(s(parsed.saudization), SAUD, 'بحاجة فحص'),\n  compliance: pick(s(parsed.compliance), COMP, '🔍 بحاجة فحص'),\n  saudization_details: s(parsed.saudization_details),\n  decision: pick(s(parsed.decision), DEC, 'Needs Review'),\n  ats, folderName, notes, cvFileName: s(meta.cvFileName) || \"cv.pdf\",\n  chunk1: chunks[0], chunk2: chunks[1], chunk3: chunks[2], chunk4: chunks[3], chunk5: chunks[4], chunk6: chunks[5]\n} };"
      }
    },
