      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst bin = $binary || {};\nconst fromRaw = j.from;\nlet from = '';\nif (typeof fromRaw === 'string') from = fromRaw;\nelse if (fromRaw) from = fromRaw.text || (fromRaw.emailAddress && fromRaw.emailAddress.address) || fromRaw.address || (fromRaw.value && fromRaw.value[0] && fromRaw.value[0].address) || '';\nconst subject = j.subject || '';\nconst messageId = j.id || j.messageId || j.internetMessageId || '';\nconst date = j.receivedDateTime || j.sentDateTime || j.date || '';\nlet chosenKey = null; let cvFileName = null;\nfor (const k of Object.keys(bin)) {\n  const b = bin[k] || {};\n  const fn = (b.fileName || '').toLowerCase();\n  const mt = (b.mimeType || '').toLowerCase();\n  if (fn.endsWith('.pdf') || mt.includes('pdf')) { chosenKey = k; cvFileName = b.fileName || 'cv.pdf'; break; }\n}\nconst outBin = {};\nif (chosenKey) outBin.data = bin[chosenKey];\nreturn { json: { subject, from, messageId, date, hasCv: !!chosenKey, cvFileName }, binary: outBin };"
      }
    },
