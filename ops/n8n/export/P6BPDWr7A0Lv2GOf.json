    {
      "id": "855cfac5-8c04-4525-83a1-397f6364b695",
      "name": "Filter New High-Impact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// يسمح فقط بالمصادر الحكومية والرسمية الموثوقة، ويمنع مواقع المنافسين\nconst TRUSTED = /(\\.gov\\.sa|\\.org\\.sa|investsaudi\\.sa|invest\\.sa)/i;\nconst BLOCKED = /(setupinsaudi|astrolabs|knowledge[ _]?feed|test[ _]?source)/i;\nconst rows = $input.all().map(i => i.json);\nconst pick = rows.filter(r => {\n  const impact = (r.property_impact_level || '').toLowerCase();\n  const gen = r.property_content_generated === true || r.property_content_generated === 'true';\n  const url = r.property_original_url || '';\n  const src = r.property_source_name || '';\n  const trusted = TRUSTED.test(url) && !BLOCKED.test(url) && !BLOCKED.test(src);\n  return (impact === 'critical' || impact === 'high') && !gen && trusted;\n}).slice(0, 3);\nreturn pick.map(r => ({ json: {\n  updateId: r.id,\n  title: r.property_update_title || r.name || '',\n  impact: r.property_impact_level || '',\n  authority: r.property_authority || '',\n  summaryAr: r.property_summary_arabic || '',\n  whatItMeans: r.property_what_it_means || '',\n  businessOpportunity: r.property_business_opportunity || '',\n  recommendedService: r.property_recommended_service || '',\n  url: r.property_original_url || ''\n} }));"
      }
    },
    {
      "id": "5c6d43d9-e533-48a0-9bdb-0dd5d81959c8",
      "name": "Generate Content (Farah)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "أنت فرح، خبيرة محتوى Business Partner. تكتبين محتوى تسويقياً عربياً احترافياً بهوية navy. لا تخترعين أرقاماً أو حقائق؛ تستخدمين المعطى فقط. كل منشور يتضمن \"قراءة Business Partner\" تربط الخبر بخدمة، بدون وعود حكومية."
        },
        "text": "=حوّلي هذا التحديث التنظيمي إلى منشور بصيغة \"تنبيه تنظيمي\":\\n\\nالعنوان: {{ $json.title }}\\nالجهة: {{ $json.authority }} | مستوى التأثير: {{ $json.impact }}\\nالملخص: {{ $json.summaryAr }}\\nماذا يعني: {{ $json.whatItMeans }}\\nفرصة الأعمال: {{ $json.businessOpportunity }}\\nالخدمة الموصى بها: {{ $json.recommendedService }}\\nالمصدر: {{ $json.url }}"
      }
    },
