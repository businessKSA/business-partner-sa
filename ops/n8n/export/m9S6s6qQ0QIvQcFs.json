        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const pre=$('Prep').first().json;const r=$input.first().json.results||[];if(!pre.ok||!r.length){return [{json:{ok:false}}];}const p=r[0].properties;const txt=x=>((x&&x.rich_text&&x.rich_text[0]&&x.rich_text[0].plain_text)||'');const st=((p['الحالة']||{}).select||{}).name||'نشط';if(st!=='نشط'){return [{json:{ok:false}}];}const conv=txt(p['ConvDB']);const tasks=txt(p['TasksDB']);const name=((p['العميل'].title||[])[0]||{}).plain_text||'عميل';const qAll=JSON.stringify({page_size:100,sorts:[{timestamp:'created_time',direction:'descending'}]});return [{json:{ok:true,name:name,conv:conv,tasks:tasks,convUrl:'https://api.notion.com/v1/databases/'+conv+'/query',tasksUrl:'https://api.notion.com/v1/databases/'+tasks+'/query',qAll:qAll}}];"
