    {
      "id": "b4cab24f-4320-4756-b845-8d31251c8cdc",
      "name": "Build Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ids=$('Resolve IDs').first().json;const convR=($('Query Conversations').first().json||{}).results||[];const taskR=($('Query Tasks').first().json||{}).results||[];const txt=x=>((x&&x.rich_text&&x.rich_text[0]&&x.rich_text[0].plain_text)||'');const title=x=>((x&&x.title&&x.title[0]&&x.title[0].plain_text)||'');const agents={};let lastTs='';const recent=[];for(const pg of convR){const p=pg.properties||{};const ag=txt(p['الوكيل'])||'khaled';agents[ag]=(agents[ag]||0)+1;const ts=pg.created_time||'';if(ts>lastTs)lastTs=ts;if(recent.length<6){recent.push({t:title(p['العنوان']).slice(0,60),agent:ag,date:(ts||'').slice(0,10)});}}const byStatus={};for(const pg of taskR){const p=pg.properties||{};const st=((p['الحالة']||{}).select||{}).name||'أخرى';byStatus[st]=(byStatus[st]||0)+1;const ts=pg.created_time||'';if(ts>lastTs)lastTs=ts;}return [{json:{ok:true,name:ids.name,conv_total:convR.length,tasks_total:taskR.length,tasks_by_status:byStatus,agents:agents,recent:recent,last_activity:lastTs}}];"
