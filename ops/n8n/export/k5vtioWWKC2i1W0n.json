    {
      "id": "8ab26f22-f64e-4f75-99cf-365f12a470c9",
      "name": "Filter Due Waiting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Release a waiting task when its follow-up time has come.\n// A wait whose due_at was already in the past when it was scheduled\n// (due_at <= reviewed_at) is an invented or stale date — releasing it at once\n// made a 10-minute loop (2026-09-24). Such waits cool off 24h after review.\nconst now = Date.now();\nconst DAY = 24 * 60 * 60 * 1000;\nreturn $input.all().filter(i => {\n  const due = Date.parse(i.json?.due_at || '');\n  if (!Number.isFinite(due) || due > now) return false;\n  const reviewed = Date.parse(i.json?.reviewed_at || '');\n  if (Number.isFinite(reviewed) && due <= reviewed) return now - reviewed >= DAY;\n  return true;\n});"
      }
    },
