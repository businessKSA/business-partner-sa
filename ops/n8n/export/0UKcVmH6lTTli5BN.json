    {
      "id": "bb390fec-31ed-4fb4-995e-f6b35df4a6a8",
      "name": "مقارنة المبلغ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const order = $(\"استخراج بيانات الطلب\").item.json;\nconst raw = $json.content || $json.output || $json.text || \"\";\nconst text = Array.isArray(raw) ? raw.map(p => (p && p.text) || \"\").join(\" \") : String(raw);\nlet parsed = {};\ntry {\n  const fence = String.fromCharCode(96,96,96);\n  let t = text.split(fence + \"json\").join(\"\").split(fence).join(\"\").trim();\n  const a = t.indexOf(\"{\"), b = t.lastIndexOf(\"}\");\n  if (a >= 0 && b > a) t = t.slice(a, b + 1);\n  parsed = JSON.parse(t);\n} catch (e) { parsed = {}; }\nlet extracted = null;\nif (parsed.amount !== undefined && parsed.amount !== null && parsed.amount !== \"\") {\n  const n = parseFloat(String(parsed.amount).replace(/,/g, \"\"));\n  if (!isNaN(n)) extracted = n;\n}\nif (extracted == null) {\n  const m = text.replace(/,/g, \"\").match(/\\d+(\\.\\d+)?/);\n  extracted = m ? parseFloat(m[0]) : null;\n}\nconst val = (v) => (v === null || v === undefined || v === \"\") ? \"غير مقروء\" : String(v);\nconst beneficiary = val(parsed.beneficiary);\nconst account = val(parsed.account);\nconst bank = val(parsed.bank);\nconst paidAt = val(parsed.date);\nlet verdict;\nif (extracted == null) verdict = \"يحتاج مراجعة يدوية\";\nelse if (Math.abs(extracted - (order.total || 0)) <= 1) verdict = \"مطابق\";\nelse verdict = \"غير مطابق\";\nconst details = \"المبلغ المقروء: \" + (extracted == null ? \"غير مقروء\" : extracted) + \" ريال · المستفيد: \" + beneficiary + \" · الحساب/الآيبان: \" + account + \" · البنك: \" + bank + \" · تاريخ التحويل: \" + paidAt;\nconst patchProperties = {\n  \"تحقق المبلغ\": { select: { name: verdict } },\n  \"تفاصيل الإيصال (قراءة آلية)\": { rich_text: [{ text: { content: details.slice(0, 1900) } }] }\n};\nif (verdict === \"مطابق\") patchProperties[\"حالة الطلب\"] = { select: { name: \"بانتظار اعتماد الدفع\" } };\nreturn { json: { pageId: order.pageId, ref: order.ref, total: order.total, extractedAmount: extracted, beneficiary, account, bank, paidAt, details, verdict, patchProperties, clientEmail: order.clientEmail, clientName: order.clientName, clientPhone: order.clientPhone, items: order.items } };\n"
      }
    },
