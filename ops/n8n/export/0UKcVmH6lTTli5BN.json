    {
      "id": "4d061c5b-9852-4399-ac64-44b76b715b62",
      "name": "استخراج بيانات الطلب",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const page = $json.order;\nconst props = page.properties || {};\nconst rt = (p) => ((p && p.rich_text) || []).map(x => x.plain_text).join(\"\");\nconst ref = rt(props[\"رقم المرجع\"]);\nconst total = (props[\"إجمالي الطلب\"] && typeof props[\"إجمالي الطلب\"].number === \"number\") ? props[\"إجمالي الطلب\"].number : null;\nconst files = (props[\"الإيصال البنكي\"] && props[\"الإيصال البنكي\"].files) || [];\nconst file = files[0];\nconst fileUrl = file ? ((file.file && file.file.url) || (file.external && file.external.url) || \"\") : \"\";\nconst notes = rt(props[\"Notes\"]);\nconst emailM = notes.match(/البريد:\\s*([^\\s·]+@[^\\s·]+)/);\nconst clientEmail = emailM ? emailM[1].trim() : \"\";\nconst phoneM = notes.match(/الجوال:\\s*([^·]+?)(?:·|$)/);\nconst clientPhone = phoneM ? phoneM[1].trim() : \"\";\nconst itemsM = notes.match(/طلب ·\\s*([^·]+?)(?:·|$)/);\nconst items = itemsM ? itemsM[1].trim() : \"\";\nconst title = ((props[\"Opportunity Name\"] && props[\"Opportunity Name\"].title) || []).map(x => x.plain_text).join(\"\");\nconst nameM = title.match(/—\\s*(.+?)\\s*\\(/);\nconst clientName = nameM ? nameM[1].trim() : \"\";\nreturn { json: { pageId: page.id, ref, total, fileUrl, hasFile: !!fileUrl, clientEmail, clientName, clientPhone, items } };"
      }
    },
