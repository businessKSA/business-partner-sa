    {
      "parameters": {
        "jsCode": "let ai = $json.output || $json;\n\nif (typeof ai === 'string') {\n  ai = ai.replace(/```json|```/g, '').trim();\n  try {\n    ai = JSON.parse(ai);\n  } catch (e) {\n    ai = {};\n  }\n}\n\nfunction clean(v) {\n  return String(v || '')\n    .replace(/[\\\\/:*?\"<>|#%{}~&]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nlet ocrText = '';\n\ntry {\n  ocrText = String($('Extract from File1').first().json.text || '');\n} catch (e) {\n  ocrText = '';\n}\n\nconst whatsappNumber =\n  clean($json._raw.messages?.[0]?.from || '');\n\nconst companyFromOCR =\n  ocrText.match(/(?:اسم المنشأة|اسم الشركة|الاسم التجاري|اسم المكلف|Taxpayer Name)\\s*[:：]?\\s*([^\\n]+)/i)?.[1] ||\n  ocrText.match(/Company(?:'s Trade Name)?\\s*[:：]?\\s*([^\\n]+)/i)?.[1] ||\n  '';\n\nconst crFromOCR =\n  ai.cr_number ||\n  ai.commercial_registration_number ||\n  ocrText.match(/(?:رقم السجل التجاري|السجل التجاري|Commercial Registration|CR Number)\\D*(\\d{10,15})/i)?.[1] ||\n  '';\n\nconst vatFromOCR =\n  ai.vat_number ||\n  ai.tax_number ||\n  ocrText.match(/(?:الرقم الضريبي|VAT Number|Tax Number)\\D*(\\d{10,20})/i)?.[1] ||\n  '';\n\nconst unifiedFromOCR =\n  ai.unified_number ||\n  ocrText.match(/(?:الرقم الموحد|National Unified No|Unified Number)\\D*(\\d{7,15})/i)?.[1] ||\n  '';\n\nconst companyName =\n  clean(ai.company_name) ||\n  clean(companyFromOCR);\n\nconst crNumber = clean(crFromOCR);\nconst vatNumber = clean(vatFromOCR);\nconst unifiedNumber = clean(unifiedFromOCR);\n\nlet clientFolderKey = '';\n\nif (crNumber) {\n  clientFolderKey = `CR-${crNumber}`;\n} else if (vatNumber) {\n  clientFolderKey = `VAT-${vatNumber}`;\n} else if (unifiedNumber) {\n  clientFolderKey = `UID-${unifiedNumber}`;\n} else if (whatsappNumber) {\n  clientFolderKey = `WA-${whatsappNumber}`;\n} else {\n  clientFolderKey = 'UNSORTED';\n}\n\nconst displayName =\n  companyName ||\n  clientFolderKey;\n\nconst googleDriveFolderName =\n  companyName\n    ? `${clientFolderKey} - ${companyName}`\n    : clientFolderKey;\n\nconst documentType =\n  clean(ai.document_type || ai.ai_classification || 'Document');\n\nconst today =\n  new Date().toISOString().slice(0, 10);\n\nconst primaryNumber =\n  crNumber || vatNumber || unifiedNumber || whatsappNumber || Date.now();\n\nconst safeDocumentType =\n  documentType\n    .replace(/\\s+/g, '_')\n    .replace(/[^\\w\\u0600-\\u06FF\\-]/g, '');\n\nconst fileName =\n  `${today}_${safeDocumentType}_${primaryNumber}.pdf`;\n\nreturn [\n  {\n    json: {\n      ...ai,\n\n      client_folder_key: clientFolderKey,\n      google_drive_folder_name: googleDriveFolderName,\n\n      client_name: displayName,\n      company_name: companyName,\n\n      cr_number: crNumber,\n      vat_number: vatNumber,\n      unified_number: unifiedNumber,\n\n      whatsapp_number: whatsappNumber,\n\n      document_type: documentType,\n      ai_classification: documentType,\n\n      document_number: primaryNumber,\n      file_name: fileName,\n      original_file_name: 'document.pdf',\n\n      source_channel: 'WhatsApp',\n      analysis_status: 'Uploaded',\n      document_status: 'Saved'\n    }\n  }\n];"
      },
