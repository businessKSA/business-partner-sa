    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Client Folder Data Code').first().json;\nconst notion = $('Search Existing Client Folder in Notion').first().json;\nconst download = $('HTTP Request - Download Media File').first();\n\nconst folderId =\n  notion.property_google_drive_folder_id ||\n  notion.google_drive_folder_id ||\n  '';\n\nif (!folderId) {\n  throw new Error('No Google Drive Folder ID found in Notion record.');\n}\n\nif (!download.binary?.data) {\n  throw new Error('No binary.data found from HTTP Request - Download Media File.');\n}\n\nreturn [\n  {\n    json: {\n      ...prep,\n      target_folder_id: String(folderId).trim(),\n      google_drive_folder_id: String(folderId).trim(),\n      google_drive_folder_link:\n        notion.property_google_drive_folder_url ||\n        notion.google_drive_folder_url ||\n        '',\n      file_name: String(prep.file_name || download.binary.data.fileName || `document-${Date.now()}.pdf`)\n        .replace(/File Name:/gi, '')\n        .replace(/\\n/g, ' ')\n        .replace(/\\s+/g, ' ')\n        .trim()\n    },\n    binary: {\n      data: download.binary.data\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        300
      ],
      "id": "a1f230e4-848f-4096-8171-55d08106ee1f",
      "name": "Merge Existing Folder With Binary"
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Client Folder Data Code').first().json;\nconst folder = $('Create folder').first().json;\nconst download = $('HTTP Request - Download Media File').first();\n\nconst folderId = folder.id || '';\n\nif (!folderId) {\n  throw new Error('No folder ID found from Create folder.');\n}\n\nif (!download.binary?.data) {\n  throw new Error('No binary.data found from HTTP Request - Download Media File.');\n}\n\nreturn [\n  {\n    json: {\n      ...prep,\n      target_folder_id: String(folderId).trim(),\n      google_drive_folder_id: String(folderId).trim(),\n      google_drive_folder_link: folder.webViewLink || folder.url || '',\n      google_drive_folder_name: prep.google_drive_folder_name,\n      file_name: String(prep.file_name || download.binary.data.fileName || `document-${Date.now()}.pdf`)\n        .replace(/File Name:/gi, '')\n        .replace(/\\n/g, ' ')\n        .replace(/\\s+/g, ' ')\n        .trim()\n    },\n    binary: {\n      data: download.binary.data\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2010,
        300
      ],
      "id": "d99a451d-a309-4e48-a0be-7ce0181c60de",
