    {
      "parameters": {
        "jsCode": "const upload = $input.first();\nconst uploadJson = upload.json || {};\n\nconst prep = $(\"Prepare Client Folder Data Code\").first().json || {};\n\nconst fileId = uploadJson.id || \"\";\nconst uploadedFileName = uploadJson.name || prep.file_name || \"\";\nconst fileLink = fileId ? `https://drive.google.com/file/d/${fileId}/view` : null;\n\nconst folderId = prep.target_folder_id || uploadJson.parents?.[0] || prep.google_drive_folder_id || \"\";\nconst folderLink = folderId ? `https://drive.google.com/drive/folders/${folderId}` : null;\n\nreturn [\n  {\n    json: {\n      document_id: String(prep.document_id || `DOC-${Date.now()}`),\n\n      client_name: String(prep.client_name || \"Unknown Client\"),\n      company_name: String(prep.company_name || prep.client_name || \"Unknown Company\"),\n\n      whatsapp_number: prep.whatsapp_number ? String(prep.whatsapp_number) : null,\n\n      document_type: String(prep.document_type || \"OTHER\"),\n      ai_classification: String(prep.ai_classification || prep.document_type || \"OTHER\"),\n      document_category: String(prep.document_category || \"Compliance Review\"),\n\n      document_number: String(prep.document_number || \"\"),\n      cr_number: String(prep.cr_number || \"\"),\n\n      file_name: String(uploadedFileName || \"\"),\n      stored_file_name: String(uploadedFileName || \"\"),\n      original_file_name: String(prep.original_file_name || \"\"),\n\n      file_size: Number(uploadJson.size || prep.file_size || 0),\n      mime_type: String(uploadJson.mimeType || prep.mime_type || \"application/pdf\"),\n\n      google_drive_file_id: String(fileId || \"\"),\n      google_drive_file_link: fileLink,\n      google_drive_folder_id: String(folderId || \"\"),\n      google_drive_folder_link: folderLink,\n      google_drive_folder_name: String(prep.google_drive_folder_name || prep.client_folder_key || \"\"),\n\n      source_channel: \"WhatsApp\",\n      analysis_status: \"Uploaded\",\n      document_status: \"Saved\",\n      review_status: \"Pending Review\",\n      ai_processed: true,\n\n      ocr_text: String(prep.ocr_text || \"\")\n    }\n  }\n];"
