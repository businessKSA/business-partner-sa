        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now=Date.now(); const maxAge=6*60*60*1000; const rows=$input.all().map(i=>i.json||{}); const due=rows.filter(r=>{ const status=r.property_status||r.Status||r.status||''; const scheduled=r.property_scheduled_date||r['Scheduled Date']||r.scheduled||r.scheduledDate||''; if(status!=='Approved'||!scheduled) return false; const t=Date.parse(scheduled); if(!Number.isFinite(t)) return false; return t<=now && t>=now-maxAge; }); return due.slice(0,10).map(r=>({json:{ pageId:r.id, platform:r.property_platform||r.Platform||r.platform||'', title:r.property_post_title||r.name||r.title||'', captionAr:r.property_caption_arabic||r.captionAr||'', captionEn:r.property_caption_english||r.captionEn||'', hashtags:r.property_hashtags||r.hashtags||'', designBrief:r.property_design_brief||r.designBrief||'', scheduled:r.property_scheduled_date||r.scheduled||'' }}));"
      }
    },
