    {
      "id": "36e86c66-1cd1-41b2-8118-99a96e72e55e",
      "name": "Parse Send Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        560
      ],
      "parameters": {
        "jsCode": "let b = $json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nconst phone = String(b.phone || '').replace(/[^0-9]/g, '');\nconst text = String(b.text || '').trim();\nlet action = String(b.action || 'send');\nif (['send','pause','resume'].indexOf(action) === -1) action = 'send';\nconst aiOff = (action === 'send' || action === 'pause');\nconst keyOk = String(b.key || '') === String($env.BP_PANEL_KEY || '');\nconst needsText = action === 'send';\nconst valid = keyOk && phone.length >= 9 && (!needsText || text.length > 0);\nreturn [{ json: { key: String(b.key||''), phone: phone, text: text, action: action, aiOff: aiOff, valid: valid } }];"
      }
    },
