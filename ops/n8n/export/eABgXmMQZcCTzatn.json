    {
      "id": "c2e19ca5-b59b-4c9e-8d8d-f9e46bde7fe2",
      "name": "Build Feed JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        120
      ],
      "parameters": {
        "jsCode": "const rows = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const p = j.properties || {};\n  function seg(prop) {\n    const src = p[prop] || {};\n    const arr = src.rich_text || src.title || [];\n    let out = '';\n    for (const x of arr) { out += (x.plain_text || ''); }\n    return out;\n  }\n  if (!j.id) continue;\n  rows.push({\n    id: j.id,\n    time: j.created_time || '',\n    phone: (p['الجوال'] && p['الجوال'].phone_number) || '',\n    sender: (p['المرسل'] && p['المرسل'].select && p['المرسل'].select.name) || '',\n    alert: (p['نوع التنبيه'] && p['نوع التنبيه'].select && p['نوع التنبيه'].select.name) || '',\n    text: seg('الرسالة') || seg('العنوان'),\n    crm: (p['رابط CRM'] && p['رابط CRM'].url) || ''\n  });\n}\nrows.sort(function(a, b) { return new Date(a.time) - new Date(b.time); });\nreturn [{ json: { ok: true, count: rows.length, messages: rows } }];"
      },
      "executeOnce": false
    },
