    {
      "id": "cda1dfe2-7ae8-4f2f-b218-5373ee23eee6",
      "name": "جهّز رسالة المتابعات",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// المصدر الوحيد: الموقع نفسه — /api/requests?action=panel-followups.\n// نفس القائمة التي تراها في /admin، فلا تختلف رسالة الواتساب عن اللوحة أبداً.\n// قبل 2026-09-16 كانت هذه العقدة تقرأ نوشن مباشرة بفلترٍ خاص بها، فكانت\n// تعيد نفس الأسماء كل نصف ساعة حتى بعد الضغط على «✅ تم التواصل».\n\nlet mode = 'digest';\ntry { mode = $('وضع التذكير').first().json.mode || 'digest'; } catch (e) {}\n\nconst payload = $input.first().json || {};\nconst all = Array.isArray(payload.followups) ? payload.followups : [];\n\n// (1) سجلاتنا نحن وسجلات الاختبار ليست عملاء ينتظرون تواصلاً.\n// «this is a test email» و«باهر مقنص» كانا يظهران كل مرة كعميلين حقيقيين.\nconst OWN_TAILS = new Set(['503793356', '530540231', '507034157']);\nconst OWN_MAILS = new Set([\n  'dr.baher.magnas@gmail.com', 'b.b.magnas@gmail.com',\n  'business@businesspartner.sa', 'business@businesspartnerksa.com',\n]);\nconst tail9 = (v) => String(v || '').replace(/\\D/g, '').slice(-9);\nconst mailOf = (r) => String(r.email || '').trim().toLowerCase();\nconst isInternal = (r) => OWN_TAILS.has(tail9(r.phone)) || OWN_MAILS.has(mailOf(r));\nconst isTest = (r) => /this is a test|\\btest\\b|اختبار|تجريب/i.test(String(r.title || '')) || /^a@a\\./i.test(mailOf(r));\n\nconst rows = [];\nlet hiddenOwn = 0, hiddenTest = 0;\nfor (const r of all) {\n  if (isInternal(r)) { hiddenOwn++; continue; }\n  if (isTest(r)) { hiddenTest++; continue; }\n  rows.push(r);\n}\n\n// (2) ذاكرة ما أُرسل: اسم العميل لا يتكرر قبل ٢٤ ساعة مهما تكرر التشغيل.\n// هذا — لا تباعد الجدولة — هو ما يوقف «نفس الأسماء كل نصف ساعة».\nconst store = $getWorkflowStaticData('global');\nif (!store.alerted || typeof store.alerted !== 'object') store.alerted = {};\nconst now = Date.now();\nconst WEEK = 7 * 24 * 3600 * 1000;\nfor (const k of Object.keys(store.alerted)) { if (now - store.alerted[k] > WEEK) delete store.alerted[k]; }\nconst COOLDOWN = 24 * 3600 * 1000;\nconst keyOf = (r) => String(r.id || r.ref || r.title || '').slice(0, 60);\nconst fresh = rows.filter((r) => { const t = store.alerted[keyOf(r)]; return !t || (now - t) > COOLDOWN; });\n\n// التذكير يذكر الجديد فقط؛ تقرير الصباح يذكر القائمة كاملة.\nconst send = mode === 'reminder' ? fresh : rows;\nif (!send.length) return [];\n\nconst tally = {};\nfor (const r of rows) {\n  const c = r.channel || {};\n  const lab = c.label || 'أخرى';\n  if (!tally[lab]) tally[lab] = { icon: c.icon || '•', n: 0 };\n  tally[lab].n++;\n}\nconst summary = Object.entries(tally).sort((a, b) => b[1].n - a[1].n).map(([lab, v]) => `${v.icon} ${lab} ${v.n}`).join(' · ');\n\nconst head = mode === 'reminder'\n  ? `🆕 ${send.length} عميل جديد يحتاج تواصلك — والاسم لا يتكرر عليك قبل ٢٤ ساعة:`\n  : `📋 متابعات اليوم — ${rows.length} عميل يحتاج تواصلك:`;\nconst maxRows = mode === 'reminder' ? 8 : 20;\nconst lines = [head];\nif (mode !== 'reminder' && summary) lines.push(summary);\nsend.slice(0, maxRows).forEach((r, i) => {\n  const c = r.channel || {};\n  const reach = r.phone ? ' · ' + r.phone : (r.email ? ' · ' + r.email : '');\n  lines.push(`${i + 1}) ${c.icon || '•'} ${c.label || ''} · ${String(r.title || '').slice(0, 90)}${reach}`);\n  lines.push(`← ${r.action || 'تابع العميل واسأله عن قراره'}`);\n});\nif (send.length > maxRows) lines.push(`…و ${send.length - maxRows} آخرون.`);\nconst hidden = hiddenOwn + hiddenTest;\nif (hidden) lines.push(`🧹 استُبعد ${hidden} سجلاً: ${hiddenOwn} لنا نحن و${hiddenTest} اختبار.`);\nlines.push('القائمة كاملة بأزرار «تم التواصل»: https://www.businesspartner.sa/admin');\n\nfor (const r of send) store.alerted[keyOf(r)] = now;\n\nlet text = lines.join('\\n');\nif (text.length > 3400) text = text.slice(0, 3400) + '…';\nconst html = '<div dir=\"rtl\" style=\"font-family:Arial,sans-serif;color:#1F2430;line-height:1.7\">'\n  + text.split('\\n').map((l) => `<div>${l.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</div>`).join('')\n  + '</div>';\nreturn [{ json: { text, html, count: send.length, total: rows.length, hidden, mode, isDigest: mode !== 'reminder' } }];\n"
      }
    },
