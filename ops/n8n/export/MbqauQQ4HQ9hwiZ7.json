      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const props = $json.properties || {};\n\nfunction rich(name) {\n  const p = props[name];\n  if (!p) return '';\n  if (p.title) return p.title.map(x => x.plain_text || '').join('').trim();\n  if (p.rich_text) return p.rich_text.map(x => x.plain_text || '').join('').trim();\n  if (p.phone_number) return String(p.phone_number || '').trim();\n  if (p.number !== undefined && p.number !== null) return String(p.number).trim();\n  if (p.select) return p.select.name || '';\n  if (p.status) return p.status.name || '';\n  return '';\n}\n\nfunction select(name) {\n  const p = props[name];\n  if (!p) return '';\n  if (p.select) return p.select.name || '';\n  if (p.status) return p.status.name || '';\n  return rich(name);\n}\n\nfunction number(name) {\n  const p = props[name];\n  if (!p) return null;\n  if (p.number !== undefined && p.number !== null) return p.number;\n  const n = Number(rich(name));\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction date(name) {\n  const p = props[name];\n  if (!p) return null;\n  if (p.date && p.date.start) return p.date.start;\n  return null;\n}\n\nconst name = rich('Name') || rich('ملاحظات');\nconst iqama = rich('Iqama NO.').replace(/\\t/g, '').replace(/\\s+/g, '').trim();\nconst unified700 = select('700') || rich('700');\nconst laborStatus = select('Labor Status');\nconst visaCompanyName = select('Visa company name');\n\nreturn {\n  json: {\n    visaPageId: $json.id,\n    name,\n    iqama,\n    unified700,\n    laborStatus,\n    visaCompanyName,\n    \n    nationality: select('Nationality ') || select('Nationality'),\n    profession: select('Profession'),\n    dateForRenewal: date('Date For Renewal'),\n    balanceStatus: select('Balance Status'),\n    wakalaNumber: number('Wakala Number'),\n    laborLicenseFees: number('Labor License Fees'),\n    lead: select('Lead'),\n    remaining: number('Remaining '),\n    qiwaFees: number('Qiwa Fees'),\n    iqamaStatus: select('Iqama Status'),\n    grFees: number('GR Fees'),\n    visaFees: number('Visa Fees'),\n    contractFees: number('Contract Fees'),\n    phone: rich('Phone'),\n    dateForWakala: date('Date for Wakala'),\n    cocFees: number('COC Fees'),\n    embassy: select('Embassy'),\n    sellNewVisaDate: date('when we can sell new visa'),\n    borderNumber: rich('border number'),\n    agencyName: select('Agency Name'),\n    contractStatus: select('Contract Status'),\n    mofaFees: number('MOFA Fees'),\n    birthDate: date('Birth Date'),\n    paid: number('Paid'),\n    dateArrival: date('Date Arrival'),\n    visaIssueDate: date('تاريخ اصدار التأشيرة'),\n    laborLicenseIssueDate: date('تاريخ اصدار رخصة العمل'),\n    contractName: select('Contract Name'),\n    laborLicenseStatus: select('Labor License status'),\n    absherAmalFees: number('Absher Amal Fees'),\n    visaNo: number('Visa NO.'),\n    feesForWakala: number('Fees for Wakala'),\n    dateOfIssueIqama: rich('Date Of Issue Iqama'),\n    insurance: select('Insurance'),\n    mofaStatus: select('MOFA Status'),\n    transferSponsorshipFees: rich('Transfer Sponsorship fees'),\n    transferSponsorshipFees1: number('Transfer Sponsorship fees 1')\n  }\n};"
      },
