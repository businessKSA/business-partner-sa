    {
      "id": "3911ceaa-60ce-4782-acce-8e937abb4053",
      "name": "Extract News Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "function textOf(v){ if(v==null) return ''; if(typeof v==='string') return v; if(typeof v==='object') return v._ || v['#text'] || ''; return String(v); }\nlet root = ($json.rss) || $json;\nlet channel = root.channel || root || {};\nlet items = channel.item || [];\nif (!Array.isArray(items)) items = items ? [items] : [];\nlet mapped = items.map(function(it){ return { title: textOf(it.title), link: textOf(it.link), pubDate: textOf(it.pubDate), source: textOf(it.source) }; });\nmapped.sort(function(a,b){ return new Date(b.pubDate) - new Date(a.pubDate); });\nmapped = mapped.slice(0, 20);\nlet lines = mapped.map(function(m, i){ return (i+1) + '. ' + m.title + (m.source ? (' — المصدر: ' + m.source) : '') + (m.link ? (' — ' + m.link) : ''); });\nreturn [{ json: { count: mapped.length, items: mapped, raw_items_text: lines.length ? lines.join('\\n') : 'لا توجد نتائج خام هذا الأسبوع.' } }];"
      }
    },
    {
      "id": "8602c330-46e7-41e6-89cb-c1ec286961da",
      "name": "Draft Weekly Digest",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
