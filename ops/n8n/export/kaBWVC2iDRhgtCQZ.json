    {
      "parameters": {
        "jsCode": "const source = $('Loop Over Items').first().json;\nconst http = $input.first().json;\n\nconst html =\n  http.data ||\n  http.body ||\n  http.response ||\n  http.html ||\n  '';\n\nconst textPreview = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 8000);\n\nconst isLoadingOnly =\n  textPreview.length < 80 ||\n  /loading|جاري التحميل/i.test(textPreview);\n\nconst hasError =\n  !!http.error ||\n  !!http.message?.toLowerCase?.().includes('timeout') ||\n  html.length === 0 ||\n  isLoadingOnly;\n\nreturn [\n  {\n    json: {\n      source_name: source.property_source_name || source.name || '',\n      source_url: source.property_website_url || '',\n      authority_type: source.property_authority_type || '',\n      priority: source.property_priority || '',\n      sectors: source.property_sector || [],\n      fetch_status: hasError ? 'failed_or_dynamic' : 'success',\n      error_message: hasError ? (http.message || http.error || 'Empty, loading-only, or dynamic JavaScript page') : '',\n      raw_html: html,\n      raw_text_preview: textPreview,\n      checked_at: new Date().toISOString()\n    }\n  }\n];"
      },
