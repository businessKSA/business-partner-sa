    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\nconst outputItems = [];\n\nfor (const item of inputItems) {\n  const input = item.json || {};\n\n  const aiOutput =\n    input.output ||\n    input.text ||\n    input.response ||\n    input.message ||\n    input.data ||\n    '';\n\n  if (!aiOutput || typeof aiOutput !== 'string') {\n    outputItems.push({\n      json: {\n        parse_status: 'failed',\n        error_message: 'No AI content output received',\n        raw_input: input\n      }\n    });\n    continue;\n  }\n\n  let cleaned = aiOutput\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const firstBrace = cleaned.indexOf('{');\n  const lastBrace = cleaned.lastIndexOf('}');\n\n  if (firstBrace !== -1 && lastBrace !== -1) {\n    cleaned = cleaned.slice(firstBrace, lastBrace + 1);\n  }\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (error) {\n    outputItems.push({\n      json: {\n        parse_status: 'failed',\n        error_message: error.message,\n        raw_output: aiOutput,\n        cleaned_output: cleaned\n      }\n    });\n    continue;\n  }\n\n  const contents = parsed.contents || [];\n\n  for (const content of contents) {\n    outputItems.push({\n      json: {\n        parse_status: 'success',\n        related_update_title: parsed.related_update_title || '',\n        original_url: parsed.original_url || '',\n        platform: content.platform || '',\n        language: content.language || 'Arabic',\n        content_title: content.title || '',\n        hook: content.hook || '',\n        caption: content.caption || '',\n        cta: content.cta || '',\n        status: 'Needs Review',\n        n8n_processed: true\n      }\n    });\n  }\n}\n\nreturn outputItems;"
      },
