    {
      "parameters": {
        "jsCode": "const originalItems = $('Has Updates?').all();\nconst duplicateItems = $input.all();\n\nreturn originalItems.map((item, index) => {\n  const original = item.json || {};\n  const duplicate = duplicateItems[index]?.json || {};\n\n  const hasDuplicate = !!(\n    duplicate.id ||\n    duplicate.url ||\n    duplicate.name ||\n    duplicate.property_duplicate_key\n  );\n\n  return {\n    json: {\n      ...original,\n      has_duplicate: hasDuplicate,\n      duplicate_check_status: hasDuplicate ? 'duplicate_found' : 'new_update',\n      duplicate_page_id: duplicate.id || '',\n      duplicate_page_url: duplicate.url || '',\n      duplicate_page_name: duplicate.name || ''\n    }\n  };\n});"
      },
