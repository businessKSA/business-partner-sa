    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output || '';\n\nlet cleaned = aiOutput\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  return [\n    {\n      json: {\n        parse_status: 'failed',\n        error_message: error.message,\n        raw_output: aiOutput\n      }\n    }\n  ];\n}\n\nconst updates = parsed.updates || [];\n\nif (!updates.length) {\n  return [\n    {\n      json: {\n        parse_status: 'success',\n        source_name: parsed.source_name || '',\n        source_url: parsed.source_url || '',\n        updates_found: 0,\n        no_updates: true\n      }\n    }\n  ];\n}\n\nreturn updates.map((update, index) => {\n  const title = update.title || `Untitled Update ${index + 1}`;\n  const sourceName = parsed.source_name || '';\n  const sourceUrl = parsed.source_url || '';\n\n  return {\n    json: {\n      parse_status: 'success',\n      source_name: sourceName,\n      source_url: sourceUrl,\n      updates_found: parsed.updates_found || updates.length,\n\n      update_title: title,\n      summary_arabic: update.summary_arabic || '',\n      affected_audience: update.affected_audience || [],\n      impact_level: update.impact_level || 'Low',\n      category: update.category || [],\n      required_action: update.required_action || '',\n      business_opportunity: update.business_opportunity || '',\n      recommended_service: update.recommended_service || '',\n      is_content_worthy: update.is_content_worthy === true,\n      is_sales_opportunity: update.is_sales_opportunity === true,\n\n      original_url: update.url || sourceUrl,\n      duplicate_key: `${sourceName}|${title}`.trim(),\n      extracted_at: new Date().toISOString()\n    }\n  };\n});"
      },
