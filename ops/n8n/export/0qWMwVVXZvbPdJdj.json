    {
      "id": "6377015e-ae37-49ab-87a1-734d7e9031a2",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const pre=$('Prep').first().json;let raw='';try{const j=$input.first().json||{};raw=(typeof j.data==='string')?j.data:(typeof j.body==='string'?j.body:'');}catch(e){}let text='';if(pre.website&&raw){text=raw.replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&[a-z#0-9]+;/gi,' ').replace(/\\s+/g,' ').trim().slice(0,7000);}let userText='';if(pre.website&&text){userText='رابط موقع العميل: '+pre.website+'\\n\\nمحتوى الموقع (نصي):\\n'+text;}if(pre.about){userText+=(userText?'\\n\\n':'')+'نبذة كتبها العميل عن شركته:\\n'+pre.about;}if(!userText){userText='لا يوجد محتوى — اكتب: لم أتمكن من قراءة الموقع.';}return [{json:{userText:userText}}];"
      }
    },
    {
      "id": "b6b3924e-226e-4f58-9f4b-39e6b4aee09a",
      "name": "Summarize Company",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1460,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Build Prompt').first().json.userText }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "أنت محلل أعمال محترف. اكتب «ملف شركة» عربياً موجزاً ومنظماً (أقل من 280 كلمة) من المحتوى المعطى فقط — لا تخترع أي معلومة. الأقسام: النشاط والوصف؛ أهم المنتجات/الخدمات؛ الجمهور المستهدف؛ الأسعار المعلنة إن وجدت؛ روابط ومعلومات تواصل وردت في المحتوى؛ نبرة العلامة. اكتبه كنص عادي بدون Markdown، بحيث يصلح كسياق دائم يقرأه فريق وكلاء ذكاء اصطناعي ليخدم هذا العميل."
            }
          ]
        }
      }
    },
