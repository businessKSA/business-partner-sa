        "jsCode": "let prof='';try{const j=$input.first().json||{};prof=(typeof j.text==='string'&&j.text)?j.text:(typeof j.output==='string'?j.output:'');}catch(e){}prof=(prof||'').trim().slice(0,1900);const rs=$('Resolve').first().json;const patchBody=JSON.stringify({properties:{'CompanyProfile':{rich_text:[{text:{content:prof}}]}}});return [{json:{profile:prof,saveUrl:rs.saveUrl,patchBody:patchBody}}];"
      }
