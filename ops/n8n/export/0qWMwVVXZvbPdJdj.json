      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/39fd108dee5c81328a17cfe65d281688/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $('Prep').first().json.qBody }}",
        "options": {}
      },
      "credentials": {
        "notionOAuth2Api": {
          "id": "USVPflXCkLXwDvRx",
          "name": "Notion — Business Partner OS — Production"
        }
      }
    },
    {
      "id": "e9169cd1-2f84-42d2-b650-ccb5412e874a",
      "name": "Resolve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const pre=$('Prep').first().json;const r=$input.first().json.results||[];if(!pre.ok||!r.length){return [{json:{ok:false}}];}const p=r[0].properties;const st=((p['الحالة']||{}).select||{}).name||'نشط';if(st!=='نشط'){return [{json:{ok:false}}];}return [{json:{ok:true,pageId:r[0].id,saveUrl:'https://api.notion.com/v1/pages/'+r[0].id}}];"
      }
    },
    {
