    {
      "id": "645f73b9-9b3f-4925-8e9e-c893abf4697b",
      "name": "Prep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b=$input.first().json.body||{};const code=((b.code||'')+'').trim().toUpperCase();let website=((b.website||'')+'').trim();const about=((b.about||'')+'').trim().slice(0,4000);if(website&&!/^https?:\\/\\//i.test(website))website='https://'+website;if(website&&!/^https?:\\/\\/[a-z0-9؀-ۿ]([a-z0-9؀-ۿ.-]*)\\.[a-z؀-ۿ]{2,}([\\/?#][^\\s]*)?$/i.test(website))website='';const ok=!!code&&code!=='DEMO123'&&(!!website||!!about);const qBody=JSON.stringify({filter:{property:'الرمز',rich_text:{equals:ok?code:'NONE'}}});return [{json:{code:code,ok:ok,website:website,about:about,fetchUrl:website||'https://invalid.invalid',qBody:qBody}}];"
      }
    },
    {
