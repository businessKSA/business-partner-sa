        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r=$input.first().json.results||[];if(!r.length){return [{json:{ok:false}}];}const p=r[0].properties;const txt=x=>((x&&x.rich_text&&x.rich_text[0]&&x.rich_text[0].plain_text)||'');const name=((p['العميل'].title||[])[0]||{}).plain_text||'عميل';const status=((p['الحالة']||{}).select||{}).name||'نشط';if(status!=='نشط'){return [{json:{ok:false,blocked:true}}];}let names={};try{const nj=JSON.parse(txt(p['AgentNames'])||'{}');if(nj&&typeof nj==='object'&&!Array.isArray(nj))names=nj;}catch(e){}const hasProfile=!!txt(p['CompanyProfile']);return [{json:{ok:true,name:name,conv:txt(p['ConvDB']),tasks:txt(p['TasksDB']),names:names,has_profile:hasProfile}}];"
