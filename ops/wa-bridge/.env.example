# ops/wa-bridge/.env.example — أسماء فقط، بلا قيم. لا تضع أي سرّ في المستودع.
# انسخه إلى ops/wa-bridge/.env واملأه على جهاز المالك أو في أسرار Azure.

# ويبهوك n8n الذي يستقبل الدفعات (سير «BP — WhatsApp Web Reader → Notion»)
WA_WEBHOOK_URL=

# السرّ المشترك لتوقيع HMAC-SHA256. نفسه يوضع في اعتماد n8n (Header Auth)،
# ولا يُكتب هنا في المستودع أبداً.
WA_BRIDGE_SECRET=

# مجلد حالة المصادقة. لكل حساب مجلد فرعي باسمه، فحظر رقم لا يمسّ الآخر.
# على Azure Container Apps: نقطة ربط قرص دائم (Azure Files).
WA_AUTH_DIR=

# مجلد طابور إعادة المحاولة على القرص (الدفعات التي فشل إرسالها إلى n8n)
WA_QUEUE_DIR=

# الحسابات: name:msisdn مفصولة بفاصلة. الأسماء المعروفة: company | personal
# مثال: company:966530540231,personal:966503793356
WA_ACCOUNTS=

# نافذة تجميع رسائل المحادثة الواحدة قبل الإرسال (ثوانٍ). الافتراضي 120.
WA_BATCH_WINDOW_S=

# تجاهل أي رسالة أقدم من هذا العدد من الساعات (يمنع غرق نوشن بالتاريخ). الافتراضي 24.
WA_IGNORE_OLDER_H=

# الإرسال من الجسر. يبقى 0 — الإصدار الأول قارئ فقط، والرقم الشخصي مقفل في الكود.
WA_SEND_ENABLED=0

# مستوى السجل: debug | info | warn | error. الافتراضي info.
WA_LOG_LEVEL=

# الربط بكود رقمي بدل QR. اضبطه 1 على Azure (السجل نصّي بلا شاشة).
WA_PAIRING_CODE=

# توقيع المتصفح المرسَل لواتساب. ثلاث قيم بفواصل.
# غيّره إن رفض حساب الربط: "Mac OS,Safari,16.5" أو "Ubuntu,Chrome,22.04.4"
WA_BROWSER=

# ─── وضع الجرد (مرة واحدة ثم يتوقّف) — ⚠️ ناقصٌ بطبيعته في هذا الجسر ─────
# Baileys بروتوكول لا صفحة: لا دالة «أعطني رسائل المحادثة س». فالمتاح هو
# ما يدفعه واتساب في `messaging-history.set` وحده، وهو يقرّر لا نحن.
# الجرد الكامل الحقيقي في ops/wa-bridge-web (جسر المتصفّح، رقم الشركة).
# التفصيل كاملاً في رأس ops/wa-bridge/src/backfill.mjs.

# 1 = شغّل الجرد. دفعاته تحمل `backfill: true` فيكتم السير تنبيهات الجوال.
WA_BACKFILL=

# نفس أسماء وافتراضات جسر المتصفّح — سقف وعدد ومدى وتباطؤ واستثناء مجموعات.
WA_BACKFILL_MAX_CHATS=
WA_BACKFILL_MSGS_PER_CHAT=
WA_BACKFILL_DAYS=
WA_BACKFILL_DELAY_MS=
WA_BACKFILL_SKIP_GROUPS=
WA_BACKFILL_FORCE=

# المزامنة الكاملة للتاريخ. الافتراضي = قيمة WA_BACKFILL.
# بـ0 لا يدفع واتساب إلا رسائل قليلة جداً فيخرج الجرد شبه فارغ.
WA_BACKFILL_FULL_HISTORY=

# مهلة انتظار ما يدفعه واتساب قبل التصريف (ملي ثانية). الافتراضي 90000.
WA_BACKFILL_COLLECT_MS=
