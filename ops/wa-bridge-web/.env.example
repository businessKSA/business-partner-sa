# ops/wa-bridge-web/.env.example — أسماء فقط، بلا قيم. لا تضع أي سرّ في المستودع.
# انسخه إلى ops/wa-bridge-web/.env واملأه على جهاز المالك أو في أسرار Azure.
#
# الأسماء مطابقة لـops/wa-bridge/.env.example حيث تشترك الوظيفة، فالعقد واحد
# والسرّ واحد والسير واحد. والمضاف هنا خاصٌّ بمحرّك المتصفّح وحده.

# ويبهوك n8n الذي يستقبل الدفعات (نفس سير «BP — WhatsApp Web Reader → Notion»
# بلا أي تعديل عليه — العقد متطابق حرفياً)
WA_WEBHOOK_URL=

# السرّ المشترك لتوقيع HMAC-SHA256. **نفس قيمة الجسر الأول** — السير واحد.
WA_BRIDGE_SECRET=

# جذر مجلدات الحالة الدائمة. على Azure: نقطة ربط Azure Files.
# هنا تُحفظ لقطات جلسة واتساب (لا ملف تعريف Chromium الحيّ — انظر أسفله).
WA_AUTH_DIR=

# طابور الدفعات التي فشل إرسالها إلى n8n
WA_QUEUE_DIR=

# الحساب: name:msisdn — **حساب واحد فقط**، ورقم الشركة وحده.
# القيمة المقصودة: company:966530540231
# الرقم الشخصي 966503793356 مرفوض في الكود منعاً مطلقاً: هو يقرأ بـBaileys
# في ops/wa-bridge ويعمل، ونقله يعني خسارة جلسة قائمة.
WA_ACCOUNTS=

# نافذة تجميع رسائل المحادثة الواحدة قبل الإرسال (ثوانٍ). الافتراضي 120.
WA_BATCH_WINDOW_S=

# تجاهل أي رسالة أقدم من هذا العدد من الساعات. الافتراضي 24.
WA_IGNORE_OLDER_H=

# الإرسال من الجسر. يبقى 0 — و1 يمنع العملية من الإقلاع.
WA_SEND_ENABLED=0

# مستوى السجل: debug | info | warn | error. الافتراضي info.
WA_LOG_LEVEL=

# ─── خاصّ بمحرّك المتصفّح ───────────────────────────────────────────────

# ملف تعريف Chromium الحيّ على قرص الحاوية المحلي. الافتراضي /home/bp/profile.
# `0` يعني «شغّل على WA_AUTH_DIR مباشرة» — يُستعمل محلياً على ماك المالك
# حيث القرص محلي أصلاً. لا تضبطه 0 على Azure: ملف تعريف Chromium قاعدتا
# LevelDB وSQLite، وتشغيلهما على Azure Files (SMB) يفسد الإغلاق.
WA_PROFILE_LOCAL_DIR=

# كل كم ثانية تُلقَط الجلسة من القرص المحلي إلى القرص الدائم. الافتراضي 300،
# والحدّ الأدنى 60. (وتُلقَط كذلك عند المصادقة والجهوز والقطع والإيقاف.)
WA_PROFILE_SNAPSHOT_S=

# حلّ أسماء المحادثات وجهات الاتصال من صفحة واتساب. الافتراضي 1.
# الدوال المستعملة (getChat/getContact) فُحص مصدرها ولا تعلّم شيئاً مقروءاً.
WA_RESOLVE_CHAT_NAMES=

# إخفاء «متصل» بعد الجهوز (sendPresenceUnavailable). الافتراضي 1.
# هو الاستدعاء الوحيد الذي يمسّ الحضور، واتجاهه إخفاء لا إظهار.
WA_HIDE_PRESENCE=

# طبع نصّ رمز QR الخام في السجل بجانب الرسم. الافتراضي 1.
# سببه أن الرسم النقطي قد يتشوّه في `az containerapp logs show`.
# ⚠️ النصّ رمز ربط صالح نحو ٦٠ ثانية: لا يُشارَك السجل أثناء الربط.
WA_QR_RAW=

# مسار Chromium. يُضبط في Dockerfile؛ وإن غاب استُعمل المرفق مع puppeteer.
PUPPETEER_EXECUTABLE_PATH=

# ─── وضع الجرد الشامل (مرة واحدة ثم يتوقّف من نفسه) ─────────────────────

# 1 = شغّل الجرد بعد استقرار الجلسة. مسارٌ منفصل عن التدفّق الحيّ تماماً:
# دفعاته تحمل `backfill: true` فيكتم السير تنبيهات الجوال عنها.
# ⚠️ لا ترفع WA_IGNORE_OLDER_H لجرد التاريخ — ذاك يخلط الأرشيف بالحيّ
# ويفقدك السقف والتباطؤ والتقدّم المحفوظ. استعمل هذا.
WA_BACKFILL=

# سقف المحادثات في الجرد (الأحدث نشاطاً أولاً). الافتراضي 200.
WA_BACKFILL_MAX_CHATS=

# رسائل لكل محادثة. الافتراضي 30 — يكفي للتصنيف بلا تضخيم التوكنات.
WA_BACKFILL_MSGS_PER_CHAT=

# أقدم ما يُقرأ، بالأيام. الافتراضي 90.
WA_BACKFILL_DAYS=

# تباطؤ **مقصود** بين المحادثات (ملي ثانية). الافتراضي 4000.
# القراءة الجماعية السريعة أظهر ما يُشتمّ منه الآلي. لا تُصفّره.
WA_BACKFILL_DELAY_MS=

# 1 = لا تجرد المجموعات. الافتراضي 0 (المالك لم يستثنِها).
WA_BACKFILL_SKIP_GROUPS=

# 1 = ألغِ علامة الاكتمال وأعد الجرد من أوله. الافتراضي 0.
# بلا هذا، الجرد المنجَز لا يُعاد عند الإقلاع (العلامة على القرص الدائم في
# <WA_AUTH_DIR>/.backfill/<account>.json — ومسح الملف يكافئ هذا المفتاح).
WA_BACKFILL_FORCE=

# قراءة ليبلات واتساب بزنس (تصنيف المالك لعملائه بيده). الافتراضي 1.
# لحسابات بزنس وحدها؛ لغيرها تُرسل labels فارغة ويُسجَّل سطرٌ واحد.
WA_READ_LABELS=
