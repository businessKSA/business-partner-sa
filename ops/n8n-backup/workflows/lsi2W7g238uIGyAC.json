{"workflow":{"id":"lsi2W7g238uIGyAC","name":"🔊 Jarvis — Voice (Azure Neural TTS)","active":true,"isArchived":false,"versionId":"5e53900e-52ab-46c0-bdc7-9baf038ea936","activeVersionId":"5e53900e-52ab-46c0-bdc7-9baf038ea936","triggerCount":2,"nodeCount":6,"createdAt":"2026-09-29T20:30:45.834Z","updatedAt":"2026-09-29T23:47:56.661Z","settings":{"executionOrder":"v1","availableInMCP":true},"tags":[],"parentFolderId":null,"scopes":["execution:delete","execution:list","execution:read","execution:reveal","workflow:create","workflow:delete","workflow:disableRedaction","workflow:enableRedaction","workflow:execute","workflow:execute-chat","workflow:export","workflow:import","workflow:list","workflow:move","workflow:publish","workflow:read","workflow:share","workflow:unpublish","workflow:unshare","workflow:update"],"canExecute":true,"connections":{"Voice POST":{"main":[[{"node":"Build SSML","type":"main","index":0}]]},"Build SSML":{"main":[[{"node":"Azure Speech TTS","type":"main","index":0}]]},"Azure Speech TTS":{"main":[[{"node":"Respond Audio","type":"main","index":0}]]},"Jarvis Page GET":{"main":[[{"node":"Serve Jarvis Map","type":"main","index":0}]]}},"nodes":[{"id":"faf1dcdd-2a5b-4f3d-aa57-066cfca0be65","name":"Voice POST","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"parameters":{"httpMethod":"POST","path":"jarvis-voice-***REDACTED***","authentication":"none","responseMode":"responseNode","options":{"allowedOrigins":"*","ignoreBots":true}},"webhookId":"a81edc17-ff91-4cf0-9105-f2a3febe9e49"},{"id":"3920b327-1223-4254-b8bf-8cd89039dc15","name":"Build SSML","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0],"parameters":{"jsCode":"// Region of the Azure Speech resource. Change here only.\nconst REGION = 'eastus2';\nconst b = ($input.first().json.body) || {};\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nlet text = esc(String(b.text || '').trim().slice(0, 900));\nif (!text) text = 'لا يوجد نص.';\nconst voice = /^[a-zA-Z-]+Neural$/.test(String(b.voice || '')) ? b.voice : 'ar-SA-ZariyahNeural';\nconst lang = voice.slice(0, 5);\nconst rate = /^[+-]?\\d{1,2}%$/.test(String(b.rate || '')) ? b.rate : '+0%';\nconst pitch = /^[+-]?\\d{1,2}%$/.test(String(b.pitch || '')) ? b.pitch : '+0%';\nconst xml = '<speak version=\"1.0\" xmlns=\"http://www.w3.org/2001/10/synthesis\" xml:lang=\"' + lang + '\"><voice name=\"' + voice + '\"><prosody rate=\"' + rate + '\" pitch=\"' + pitch + '\">' + text + '</prosody></voice></speak>';\nreturn [{ json: { ssml: xml, url: 'https://' + REGION + '.tts.speech.microsoft.com/cognitiveservices/v1', voice } }];","language":"javaScript","mode":"runOnceForAllItems"}},{"id":"24bb82b9-9c0f-48ed-ae73-6812f8882652","name":"Azure Speech TTS","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[448,0],"parameters":{"method":"POST","url":"={{ $json.url }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"specifyHeaders":"keypair","headerParameters":{"parameters":[{"name":"Content-Type","value":"application/ssml+xml"},{"name":"X-Microsoft-OutputFormat","value":"audio-24khz-48kbitrate-mono-mp3"},{"name":"User-Agent","value":"bp-jarvis"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/ssml+xml","body":"={{ $json.ssml }}","options":{"timeout":20000,"response":{"response":{"responseFormat":"file","outputPropertyName":"data"}}}},"credentials":{"httpHeaderAuth":{"id":"Bc5WhdQOljUDeKhp","name":"Azure Speech — Jarvis"}}},{"id":"752f5108-7eb6-46d3-81b5-e41cfa0cec0c","name":"Respond Audio","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[672,0],"parameters":{"respondWith":"binary","responseDataSource":"set","inputFieldName":"data","options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"audio/mpeg"},{"name":"Cache-Control","value":"no-store"}]}}}},{"id":"jarvis-page-get","name":"Jarvis Page GET","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,260],"parameters":{"authentication":"none","httpMethod":"GET","options":{"ignoreBots":true},"path":"jarvis-map-***REDACTED***","responseMode":"responseNode"},"webhookId":"0399a3de-8f16-4a3d-9351-336918b53140"},{"id":"jarvis-page-respond","name":"Serve Jarvis Map","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[224,260],"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Cache-Control","value":"no-store"},{"name":"X-Robots-Tag","value":"noindex, nofollow"},{"name":"Referrer-Policy","value":"no-referrer"}]}},"respondWith":"text","responseBody":"<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\">\n<title>جارفس — خارطة الفريق</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Cairo:wght@800;900&family=IBM+Plex+Mono:wght@400;500&display=swap\">\n<style>\n:root{--bg:#060a11;--bg-2:#0c1320;--panel:#101827;--line:#1e2a3c;--fg:#e8eef7;--muted:#8d9bb0;--accent:#38d6d0;--accent-ink:#04211f;--work:#f2b544;--ok:#5fd38a;--bad:#ff6b6b;--display:'Cairo','IBM Plex Sans Arabic',system-ui,sans-serif;--body:'IBM Plex Sans Arabic',system-ui,-apple-system,'Segoe UI',sans-serif;--mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;color-scheme:dark}\n*{box-sizing:border-box}html,body{height:100%}\nbody{margin:0;background:radial-gradient(1200px 700px at 50% 40%,#0b1524 0%,var(--bg) 60%);color:var(--fg);font-family:var(--body);font-size:14px;line-height:1.65;direction:rtl}\n.deck{display:grid;grid-template-rows:auto auto 1fr;height:100dvh;gap:10px;padding:10px 12px}\nheader{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}\n.brand{display:flex;align-items:baseline;gap:10px}.brand h1{font-family:var(--display);font-weight:900;font-size:26px;margin:0;color:var(--accent)}.brand small{color:var(--muted);font-size:12px}\n.hdr-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}\n.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:3px 10px;font-size:12px;color:var(--muted);background:var(--bg-2);font-variant-numeric:tabular-nums}\n.pill .dot{width:8px;height:8px;border-radius:50%;background:var(--muted)}.pill.ok .dot{background:var(--ok);box-shadow:0 0 8px var(--ok)}.pill.bad .dot{background:var(--bad)}.pill.busy .dot{background:var(--work);animation:blink 1s infinite}\n@keyframes blink{50%{opacity:.25}}\nbutton{font-family:inherit;font-size:13px;cursor:pointer;border-radius:10px;border:1px solid var(--line);background:var(--bg-2);color:var(--fg);padding:7px 11px}\nbutton:hover{border-color:var(--accent)}button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\nbutton.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:700}button.on{border-color:var(--accent);color:var(--accent)}button:disabled{opacity:.5;cursor:default}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px}\n.kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:8px 12px}\n.kpi b{display:block;font-family:var(--display);font-size:22px;line-height:1.2;font-variant-numeric:tabular-nums}.kpi span{font-size:11.5px;color:var(--muted)}\n.kpi.warn b{color:var(--work)}.kpi.good b{color:var(--ok)}.kpi.bad b{color:var(--bad)}\nmain{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.8fr);gap:10px;min-height:0}\n@media (max-width:900px){main{grid-template-columns:1fr;grid-template-rows:minmax(300px,48vh) 1fr}}\n.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;min-width:0;min-height:0;display:flex;flex-direction:column}\n.map{position:relative;overflow:hidden}\n.map svg{width:100%;height:100%;display:block}\n.node{cursor:pointer}\n.node circle.core{fill:#142033;stroke:#2b3b52;stroke-width:1.5;transition:stroke .2s,filter .2s}\n.node:hover circle.core,.node.sel circle.core{stroke:var(--accent);filter:drop-shadow(0 0 6px rgba(56,214,208,.6))}\n.node.busy circle.core{stroke:var(--work);filter:drop-shadow(0 0 10px rgba(242,181,68,.7))}\n.node.busy circle.halo{animation:pulse 1.4s ease-out infinite}\n.node.paused circle.core{stroke:var(--bad);opacity:.6}\n.node text{fill:var(--fg);font-family:var(--body);font-size:13px;font-weight:600;text-anchor:middle;pointer-events:none}\n.node text.init{font-family:var(--display);font-weight:900;font-size:17px;fill:#dfe8f3}\n.node text.sub{fill:var(--muted);font-size:10.5px;font-weight:400}\n.node .cnt{fill:var(--work);font-family:var(--mono);font-size:9px;font-weight:600}\n.node .sat{fill:#2b3b52}.node.busy .sat{fill:var(--work)}.node.sel .sat{fill:var(--accent)}\n.link{stroke:#1e2a3c;stroke-width:1.2;fill:none}\n.web{stroke:#182335;stroke-width:.8;fill:none;opacity:.9}\n.chord{stroke:#1a2740;stroke-width:.7;fill:none;opacity:.55}\n.chord.hot{stroke:var(--accent);stroke-width:1.6;opacity:.9;stroke-dasharray:3 5;animation:flow 1s linear infinite}\n.link.busy{stroke:var(--work);stroke-width:1.8;stroke-dasharray:4 6;animation:flow 1.2s linear infinite}\n.link.sel{stroke:var(--accent)}\n@keyframes flow{to{stroke-dashoffset:-20}}\n@keyframes pulse{0%{r:29;opacity:.6}100%{r:48;opacity:0}}\n.center circle{fill:#0f2a2a;stroke:var(--accent);stroke-width:2}\n.center text{fill:var(--accent);font-family:var(--display);font-weight:900;font-size:16px;text-anchor:middle;pointer-events:none}\n.center text.sub{fill:var(--muted);font-family:var(--body);font-weight:400;font-size:10px}\n.center.busy circle{filter:drop-shadow(0 0 14px rgba(56,214,208,.8))}\n.legend{position:absolute;bottom:8px;right:10px;font-size:11px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap;background:rgba(6,10,17,.7);padding:4px 8px;border-radius:8px}\n.legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-inline-start:4px;vertical-align:middle}\n.side{overflow:hidden}\n.tabs{display:flex;border-bottom:1px solid var(--line)}\n.tabs button{border:0;border-radius:0;background:transparent;padding:9px 10px;color:var(--muted);flex:1;font-weight:600;font-size:12.5px}\n.tabs button.on{color:var(--accent);box-shadow:inset 0 -2px 0 var(--accent)}\n.tab{display:none;flex:1;min-height:0;flex-direction:column;padding:10px}.tab.on{display:flex}\n.chat .log{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:8px;padding:2px;min-height:120px}\n.msg{max-width:94%;padding:8px 11px;border-radius:12px;white-space:pre-wrap;word-break:break-word;font-size:13.5px}\n.msg.me{align-self:flex-start;background:#18324a;border:1px solid #23496a}.msg.ai{align-self:flex-end;background:var(--bg-2);border:1px solid var(--line)}\n.msg .who{display:block;font-size:11px;color:var(--muted);margin-bottom:2px;font-family:var(--mono)}.msg .voice{font-weight:600}\n.msg .details{margin-top:6px;padding-top:6px;border-top:1px dashed var(--line);color:#c6d0de;font-size:13px}\n.msg.sys{align-self:center;background:transparent;border:0;color:var(--muted);font-size:12px;font-family:var(--mono)}\n.msg.ai.speaking{border-color:var(--accent)}\n.composer{display:flex;gap:6px;margin-top:8px;align-items:flex-end}\n.composer textarea{flex:1;min-width:0;resize:none;border:1px solid var(--line);background:var(--bg-2);color:var(--fg);border-radius:12px;padding:9px 11px;font-family:inherit;font-size:14px;line-height:1.5;min-height:44px}\n.mic{width:44px;height:44px;border-radius:50%;padding:0;font-size:18px;flex:none}.mic.rec{background:var(--bad);border-color:var(--bad);color:#fff;animation:blink 1s infinite}\n.bar{display:flex;gap:8px;align-items:center;font-size:11.5px;color:var(--muted);margin-top:5px;flex-wrap:wrap}.bar .lvl{flex:1;height:4px;background:var(--line);border-radius:2px;overflow:hidden;min-width:60px}.bar .lvl i{display:block;height:100%;width:0;background:var(--accent);transition:width .08s}\n.quick{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:6px}.quick button{font-size:11.5px;padding:4px 8px;border-radius:999px}\n.hint{font-size:12px;color:var(--muted);margin:4px 0 0}\n.who-card{border:1px solid var(--line);border-radius:12px;padding:10px;background:var(--bg-2);margin-bottom:8px}\n.who-card h3{margin:0 0 4px;font-family:var(--display);font-size:16px}.who-card p{margin:2px 0;font-size:12.5px;color:var(--muted)}\n.who-card .team span{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:1px 8px;margin:2px;font-size:11.5px;color:var(--fg)}\n.needs{overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:8px}\n.need{border:1px solid #4a3a12;background:#1a1608;border-radius:12px;padding:9px 11px}\n.need b{display:block;font-size:13px}.need p{margin:3px 0 6px;font-size:12.5px;color:#d9c48f}.need small{color:var(--muted);font-family:var(--mono);font-size:10.5px}\n.need .act{display:flex;gap:6px;margin-top:6px}.need .act button{font-size:12px;padding:5px 9px}\n.empty{color:var(--muted);font-size:12.5px;text-align:center;padding:20px 8px}\n.feed{font-family:var(--mono);font-size:11.5px;color:var(--muted);display:flex;flex-direction:column;gap:3px;overflow-y:auto;flex:1}\n.feed div{display:flex;gap:8px}.feed time{color:#5f6f86;flex:none;font-variant-numeric:tabular-nums}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<div class=\"deck\">\n  <header>\n    <div class=\"brand\"><h1>جارفس</h1><small>خارطة فريق Business Partner الذكي · حيّة من n8n · كل أمر يمرّ عبر فرح</small></div>\n    <div class=\"hdr-actions\">\n      <span class=\"pill\" id=\"pulse\"><span class=\"dot\"></span><span id=\"pulseTxt\">نبض حي: يقرأ…</span></span>\n      <span class=\"pill\" id=\"voicePill\"><span class=\"dot\"></span><span id=\"voiceEng\">الصوت: يُحدّد عند أول رد</span></span>\n      <span class=\"pill\" id=\"health\"><span class=\"dot\"></span><span id=\"healthTxt\">فرح: لم تُفحص بعد</span></span>\n      <button id=\"healthBtn\" type=\"button\">فحص فرح</button>\n      <button id=\"voiceBtn\" type=\"button\" class=\"on\">🔊 النطق</button>\n      <button id=\"handsBtn\" type=\"button\" title=\"بعد كل رد يفتح المايك تلقائياً\">🎧 وضع جارفس</button>\n    </div>\n  </header>\n  <section class=\"kpis\">\n    <div class=\"kpi good\"><b id=\"kActive\">—</b><span>موظف ذكي نشط</span></div>\n    <div class=\"kpi warn\"><b id=\"kProg\">—</b><span>مهمة قيد التنفيذ الآن</span></div>\n    <div class=\"kpi\"><b id=\"kOpen\">—</b><span>مهمة مفتوحة</span></div>\n    <div class=\"kpi bad\"><b id=\"kNeeds\">—</b><span>تنتظرك أنت</span></div>\n    <div class=\"kpi\"><b id=\"kPaused\">—</b><span>متوقف</span></div>\n  </section>\n  <main>\n    <section class=\"panel map\" id=\"mapPanel\">\n      <svg id=\"map\" viewBox=\"0 0 1000 700\" preserveAspectRatio=\"xMidYMid meet\" aria-label=\"خارطة الفريق\"></svg>\n      <div class=\"legend\"><span><i style=\"background:var(--work)\"></i>يعمل الآن</span><span><i style=\"background:#1a2740\"></i>خيوط الشبكة = كل إدارة تستشير كل إدارة</span><span><i style=\"background:var(--accent)\"></i>المختار</span><span><i style=\"background:var(--bad)\"></i>متوقف</span><span><i style=\"background:#2b3b52\"></i>فريقه (نقاط)</span></div>\n    </section>\n    <section class=\"panel side\">\n      <div class=\"tabs\">\n        <button type=\"button\" class=\"on\" data-tab=\"chat\">المحادثة</button>\n        <button type=\"button\" data-tab=\"needs\">يحتاجونك <span id=\"needsBadge\"></span></button>\n        <button type=\"button\" data-tab=\"feed\">السجل</button>\n      </div>\n      <div class=\"tab chat on\" id=\"tab-chat\">\n        <div class=\"who-card\" id=\"whoCard\"></div>\n        <div class=\"quick\">\n          <button type=\"button\" data-q=\"وش علي اليوم؟\">وش علي اليوم؟</button>\n          <button type=\"button\" data-q=\"تقرير حالة الشركة الآن: المهام، الصفقات، الفريق، المؤشرات — الحلو والسيئ.\">تقرير الشركة</button>\n          <button type=\"button\" data-q=\"وش يشتغل عليه الفريق الآن؟ اقرئي المهام المفتوحة ولخّصيها.\">من يشتغل الآن؟</button>\n        </div>\n        <div class=\"log\" id=\"log\"></div>\n        <form class=\"composer\" id=\"form\">\n          <button type=\"button\" class=\"mic\" id=\"mic\" title=\"تكلّم\">🎙️</button>\n          <textarea id=\"input\" rows=\"1\" placeholder=\"اكتب أو اضغط المايك وتكلّم… (اضغط مطوّلاً لتسجيل أطول)\"></textarea>\n          <button class=\"primary\" id=\"send\" type=\"submit\">أرسل</button>\n        </form>\n        <div class=\"bar\"><span id=\"micState\">المايك: جاهز</span><span class=\"lvl\"><i id=\"lvl\"></i></span><span id=\"ttsState\"></span></div>\n        <p class=\"hint\" id=\"micHint\" hidden></p>\n      </div>\n      <div class=\"tab\" id=\"tab-needs\"><div class=\"needs\" id=\"needs\"><div class=\"empty\">يقرأ…</div></div><p class=\"hint\">هذه المهام في جدول المهام وموقوفة عليك أنت. «خلصت» يخبر فرح فتغلقها وتستأنف الفريق.</p></div>\n      <div class=\"tab\" id=\"tab-feed\"><div class=\"feed\" id=\"feed\"></div></div>\n    </section>\n  </main>\n</div>\n<script>\n\nconst CMD = 'https://businesspartnerai.app.n8n.cloud/webhook/muin-command-space-***REDACTED***';\nconst HEALTH = 'https://businesspartnerai.app.n8n.cloud/webhook/muin-health-***REDACTED***';\nconst PULSE = 'https://businesspartnerai.app.n8n.cloud/webhook/jarvis-pulse-***REDACTED***';\nconst VOICE = 'https://businesspartnerai.app.n8n.cloud/webhook/jarvis-voice-***REDACTED***';\n// BP_AI_Tasks / BP_Agent_Registry ids → roster ids\nconst PULSE_MAP = {farah_chief_of_staff:'farah',chief_of_staff:'farah',farah:'farah',abdulrahman_cfo:'abdulrahman',badr_sales:'badr',abdulaziz_legal:'abdulaziz',abdulrahman_finance:'abdulrahman',mazen_ops:'mazen',mishari_compliance:'mishari',nasser_hr:'nasser',abdullah_procurement:'abdullah',mohammed_it:'mohammed',website_funnel_ops:'salman',ahmed_strategy:'ahmed',farah_marketing:'sara',sara_marketing:'sara',tariq_realestate:'tariq',alaa_news:'alaa',deals_revenue_ops:'wissam',bandar_recruitment:'bandar',malak:'malak',malak_assistant:'malak',baher_front_desk:'baher',virtual_baher:'baher'};\n// Azure Neural voices: one per manager, Gulf accents, pitch/rate shifts so no two sound alike.\nconst VOICES = {farah:['ar-SA-ZariyahNeural','+0%','+0%'],sara:['ar-AE-FatimaNeural','+3%','+4%'],malak:['ar-QA-AmalNeural','+2%','+6%'],alaa:['ar-BH-LailaNeural','+0%','-3%'],badr:['ar-SA-HamedNeural','+4%','+0%'],salman:['ar-AE-HamdanNeural','+0%','+3%'],mohammed:['ar-QA-MoazNeural','+3%','-2%'],abdulrahman:['ar-BH-AliNeural','-3%','-4%'],mazen:['ar-KW-FahedNeural','+2%','+0%'],nasser:['ar-OM-AbdullahNeural','+0%','-2%'],abdulaziz:['ar-SA-HamedNeural','-4%','-6%'],mishari:['ar-AE-HamdanNeural','-2%','-3%'],abdullah:['ar-KW-FahedNeural','+0%','+5%'],ahmed:['ar-QA-MoazNeural','-3%','+3%'],tariq:['ar-BH-AliNeural','+3%','+4%'],bandar:['ar-OM-AbdullahNeural','+4%','+4%'],wissam:['ar-SA-HamedNeural','+0%','+6%'],baher:['ar-SA-HamedNeural','-2%','+2%']};\n\nconst AGENTS = [\n  {id:'farah', slug:'', name:'فرح', role:'رئيسة المكتب التنفيذي', team:'تدير المديرين كلهم', keys:['فرح']},\n  {id:'salman', slug:'website-funnel-ops', name:'سلمان', role:'مدير المنتج', team:'لمى · جنى · وليد', keys:['سلمان']},\n  {id:'badr', slug:'badr-intake', name:'بدر', role:'المبيعات وتطوير الأعمال', team:'خالد · فيصل · نواف · تركي · عمر · عبدالإله · ياسر', keys:['بدر']},\n  {id:'sara', slug:'farah-intake', name:'سارة', role:'النمو والتسويق', team:'ريم · ليان · نور · جود · دانا · راكان', keys:['سارة']},\n  {id:'mohammed', slug:'mohammed-intake', name:'محمد', role:'تقنية المعلومات والهندسة', team:'زياد · رامي · سيف · أنس · مروان · يزن', keys:['محمد']},\n  {id:'abdulrahman', slug:'abdulrahman-intake', name:'عبدالرحمن', role:'المدير المالي', team:'رنا · فهد · مها · يوسف', keys:['عبدالرحمن','المالية']},\n  {id:'mazen', slug:'mazen-intake', name:'مازن', role:'العمليات والتسليم', team:'هتان · رائد · طلال · مشعل', keys:['مازن']},\n  {id:'nasser', slug:'nasser-intake', name:'ناصر', role:'الموارد البشرية والتوظيف (لنا وللعملاء)', team:'هدى · أروى · غادة · فواز (داخلي فقط)', keys:['ناصر']},\n  {id:'abdulaziz', slug:'abdulaziz-intake', name:'عبدالعزيز', role:'المدير القانوني', team:'سمر · لؤي · هلا', keys:['عبدالعزيز','القانوني']},\n  {id:'mishari', slug:'mishari-intake', name:'مشاري', role:'الامتثال والعلاقات الحكومية', team:'عادل · زيد · نجلاء', keys:['مشاري']},\n  {id:'abdullah', slug:'ahmed-procurement', name:'عبدالله', role:'المشتريات', team:'سامي · معاذ · نورة', keys:['عبدالله']},\n  {id:'ahmed', slug:'strategy-intake', name:'أحمد', role:'الاستراتيجية وPMO', team:'باسل · هيا', keys:['أحمد']},\n  {id:'malak', slug:'malak-intake', name:'ملاك', role:'المساعِدة التنفيذية', team:'تعمل منفردة', keys:['ملاك']},\n  {id:'tariq', slug:'realestate-intake', name:'طارق', role:'العقارات', team:'بشائر · منيرة · عبدالوهاب', keys:['طارق']},\n  {id:'bandar', slug:'recruitment-intake', name:'بندر', role:'منتجات الاستقدام (PEO/EOR، عمالة مسندة)', team:'شهد · إياد · لينا · راشد', keys:['بندر']},\n  {id:'alaa', slug:'news-intake', name:'آلاء', role:'الأخبار والمحتوى التنظيمي', team:'رهف · تميم', keys:['آلاء']},\n  {id:'wissam', slug:'deals-intake', name:'وسام', role:'مكتب الصفقات (قراءة وتصعيد فقط)', team:'جواهر · فارس', keys:['وسام']},\n  {id:'baher', slug:'', name:'باهر Front Desk', role:'واجهة شات الموقع العام', team:'يوجّه الزوار للإدارات', keys:['باهر']},\n];\n\nconst $ = id => document.getElementById(id);\nconst log=$('log'), feed=$('feed'), input=$('input'), form=$('form'), mic=$('mic'), micHint=$('micHint');\nlet selected='farah', voiceOn=true, busy=false, handsFree=false;\ntry{ selected = localStorage.getItem('jarvis.agent') || 'farah'; voiceOn = localStorage.getItem('jarvis.voice') !== 'off'; handsFree = localStorage.getItem('jarvis.hands') === 'on'; }catch{}\n// iOS/Safari: audio must be unlocked by a user gesture once; afterwards the same element can play fetched blobs.\nlet player=null, unlocked=false;\nfunction unlockAudio(){ if(unlocked) return; unlocked=true; try{ player=new Audio(); player.src='data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAIA+AAACABAAZGF0YQAAAAA='; player.play().catch(()=>{}); }catch{} try{ if('speechSynthesis' in window){ const u=new SpeechSynthesisUtterance(' '); u.volume=0; speechSynthesis.speak(u); } }catch{} }\n['pointerdown','keydown','touchstart'].forEach(ev=>document.addEventListener(ev,unlockAudio,{once:true,passive:true}));\nfunction afterSpeech(){ $('ttsState').textContent=''; document.querySelectorAll('.msg.ai.speaking').forEach(m=>m.classList.remove('speaking')); if(handsFree && !busy && !recording) setTimeout(()=>startListening(),350); }\n\nfunction fmtTime(){ return new Date().toLocaleTimeString('ar-SA',{hour:'2-digit',minute:'2-digit',second:'2-digit'}); }\nfunction logEvent(text){ const d=document.createElement('div'); d.innerHTML=`<time>${fmtTime()}</time><span class=\"ev\"></span>`; d.querySelector('.ev').textContent=text; feed.prepend(d); }\nfunction addMsg(kind, who, text, details){\n  const m=document.createElement('div'); m.className='msg '+kind;\n  if(kind==='sys'){ m.textContent=text; }\n  else{\n    const w=document.createElement('span'); w.className='who'; w.textContent=who; m.appendChild(w);\n    const v=document.createElement('div'); v.className='voice'; v.textContent=text; m.appendChild(v);\n    if(details){ const dd=document.createElement('div'); dd.className='details'; dd.textContent=details; m.appendChild(dd); }\n  }\n  log.appendChild(m); log.scrollTop=log.scrollHeight; return m;\n}\n\nlet azureOk=null;\nfunction speakBrowser(text){\n  if(!('speechSynthesis' in window)){ afterSpeech(); return; }\n  try{\n    speechSynthesis.cancel();\n    const u=new SpeechSynthesisUtterance(text); u.lang='ar-SA'; u.rate=1;\n    const v=speechSynthesis.getVoices().find(v=>/^ar/i.test(v.lang)); if(v) u.voice=v;\n    u.onend=afterSpeech; u.onerror=afterSpeech; $('ttsState').textContent='ينطق (صوت المتصفح)…';\n    speechSynthesis.speak(u);\n  }catch{ afterSpeech(); }\n}\nfunction stopSpeaking(){ try{ speechSynthesis.cancel(); }catch{} if(player){ try{ player.pause(); player.currentTime=0; }catch{} } }\nasync function speak(text, agentId){\n  if(!voiceOn || !text){ afterSpeech(); return; }\n  stopSpeaking();\n  const [voice,rate,pitch]=VOICES[agentId]||VOICES.farah;\n  if(azureOk!==false){\n    try{\n      const ctl=new AbortController(); const t=setTimeout(()=>ctl.abort(),20000);\n      const r=await fetch(VOICE,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({text:text.slice(0,900),voice,rate,pitch}),signal:ctl.signal});\n      clearTimeout(t);\n      if(!r.ok) throw new Error('HTTP '+r.status);\n      const blob=await r.blob(); if(!blob.size||!/audio/.test(blob.type||'audio')) throw new Error('empty audio');\n      if(!player) player=new Audio();\n      player.onended=afterSpeech; player.onerror=afterSpeech;\n      player.src=URL.createObjectURL(blob); $('ttsState').textContent='ينطق (Azure)…';\n      const last=log.querySelector('.msg.ai:last-of-type'); if(last) last.classList.add('speaking');\n      await player.play();\n      if(azureOk!==true){ azureOk=true; $('voiceEng').textContent='الصوت: Azure Neural'; $('voicePill').className='pill ok'; logEvent('صوت Azure يعمل — '+voice); }\n      return;\n    }catch(e){\n      if(azureOk!==false){ azureOk=false; $('voiceEng').textContent='الصوت: المتصفح (Azure غير مفعّل بعد)'; logEvent('Azure Speech غير متاح ('+(e.message||e)+') — تحوّلت لصوت المتصفح. فعّل اعتماد «Azure Speech — Jarvis» في n8n.'); }\n    }\n  }\n  speakBrowser(text);\n}\n\nfunction parseReply(raw){\n  let s=String(raw||'').trim(); let voice=s, details='';\n  const i=s.indexOf('[[DETAILS]]');\n  if(i>=0){ voice=s.slice(0,i).trim(); details=s.slice(i+11).trim(); }\n  voice=voice.replace(/^VOICE:\\s*/i,'').trim();\n  return {voice,details};\n}\nfunction guessWorkers(text){\n  const hits=new Set();\n  AGENTS.forEach(a=>a.keys.forEach(k=>{ if(text.includes(k)) hits.add(a.id); }));\n  return hits;\n}\n\nasync function send(text){\n  text=(text||'').trim(); if(!text||busy) return;\n  stopSpeaking(); busy=true; $('send').disabled=true; clearDone();\n  const target=AGENTS.find(a=>a.id===selected);\n  addMsg('me','باهر',text);\n  let body=text;\n  if(target && target.slug){ body=`وجّهي هذا الطلب إلى ${target.name} (${target.slug}) عبر Consult Executive Team وأعيدي لي رده كاملاً كما هو، ثم أضيفي رأيك في سطر واحد إن لزم.\\n\\nالطلب: ${text}`; }\n  if(target && target.id==='baher'){ body=`هذا طلب موجّه لباهر Front Desk (واجهة الموقع). أجيبي كما لو أنك تراجعين ما سيقوله للزائر.\\n\\nالطلب: ${text}`; }\n  setWork('farah',true); if(target&&target.slug) setWork(target.id,true);\n  logEvent('أُرسل إلى فرح'+(target&&target.slug?' → '+target.name:''));\n  $('health').className='pill busy'; $('healthTxt').textContent='فرح تعمل…';\n  const thinking=addMsg('sys','','فرح تقرأ وتنفّذ…');\n  const ctl=new AbortController(); const t=setTimeout(()=>ctl.abort(),150000);\n  const t0=Date.now();\n  try{\n    const r=await fetch(CMD,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({message:body,target_agent:target?target.slug||target.id:''}),signal:ctl.signal});\n    const data=await r.json().catch(()=>({}));\n    const secs=((Date.now()-t0)/1000).toFixed(1);\n    thinking.remove();\n    if(!r.ok) throw new Error('HTTP '+r.status);\n    const {voice,details}=parseReply(data.reply||data.output||data.text||'');\n    const who=(target&&target.slug)?`فرح ← ${target.name}`:'فرح';\n    addMsg('ai',who,voice||'(رد فارغ)',details);\n    const ws=[...guessWorkers(voice+' '+details)].filter(id=>id!=='farah'); if(target&&target.slug&&!ws.includes(target.id)) ws.push(target.id);\n    ws.forEach(id=>{ setWork(id,true); setTimeout(()=>setWork(id,false),2500); });\n    for(let i=0;i<ws.length;i++) for(let j=i+1;j<ws.length;j++){ const c=chordEls[ws[i]+'|'+ws[j]]; if(c){ c.classList.add('hot'); setTimeout(()=>c.classList.remove('hot'),4000); } }\n    logEvent(`وصل الرد خلال ${secs} ث${data.model_failure?' — تعذّر المحرّك':''}`);\n    $('health').className='pill ok'; $('healthTxt').textContent='فرح: متصلة · آخر رد '+secs+' ث';\n    speak(voice, (target&&target.slug)?target.id:'farah');\n  }catch(e){\n    thinking.remove();\n    const why=e.name==='AbortError'?'انتهت المهلة (150 ث) — فرح لم ترد':String(e.message||e);\n    addMsg('sys','','تعذّر الوصول: '+why+'. إن كنت تفتح هذه الصفحة من داخل تطبيق Claude وفشل الطلب، افتح ملف جارفس مباشرة في المتصفح.');\n    logEvent('فشل: '+why);\n    $('health').className='pill bad'; $('healthTxt').textContent='فرح: غير متاحة';\n    afterSpeech();\n  }finally{\n    clearTimeout(t); setWork('farah',false); if(target&&target.slug) setWork(target.id,false); busy=false; $('send').disabled=false; input.focus();\n  }\n}\n\nform.addEventListener('submit',e=>{ e.preventDefault(); const v=input.value; input.value=''; send(v); });\ninput.addEventListener('keydown',e=>{ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); form.requestSubmit(); } });\ndocument.querySelectorAll('.quick button').forEach(b=>b.onclick=()=>send(b.dataset.q));\n\n$('voiceBtn').onclick=()=>{ voiceOn=!voiceOn; try{localStorage.setItem('jarvis.voice',voiceOn?'on':'off')}catch{} $('voiceBtn').textContent=voiceOn?'🔊 النطق: مفعّل':'🔇 النطق: مطفأ'; $('voiceBtn').classList.toggle('on',voiceOn); if(!voiceOn) try{speechSynthesis.cancel()}catch{} };\n$('voiceBtn').textContent=voiceOn?'🔊 النطق: مفعّل':'🔇 النطق: مطفأ'; $('voiceBtn').classList.toggle('on',voiceOn);\nfunction renderHands(){ $('handsBtn').textContent=handsFree?'🎧 وضع جارفس: يعمل':'🎧 وضع جارفس: مطفأ'; $('handsBtn').classList.toggle('on',handsFree); }\n$('handsBtn').onclick=()=>{ handsFree=!handsFree; try{localStorage.setItem('jarvis.hands',handsFree?'on':'off')}catch{} renderHands(); if(handsFree){ voiceOn=true; $('voiceBtn').textContent='🔊 النطق: مفعّل'; $('voiceBtn').classList.add('on'); addMsg('sys','','وضع جارفس: تكلّم، تسمع الرد، ويفتح المايك من نفسه بعد كل رد. قل «توقف» لإيقافه.'); logEvent('وضع جارفس مفعّل'); startListening(); } else { if(recording) try{rec.stop()}catch{} logEvent('وضع جارفس أُطفئ'); } };\nrenderHands();\n\n$('healthBtn').onclick=async()=>{\n  $('health').className='pill busy'; $('healthTxt').textContent='يفحص…'; logEvent('فحص اتصال فرح');\n  const t0=Date.now();\n  try{ const r=await fetch(HEALTH); const d=await r.json().catch(()=>({})); const secs=((Date.now()-t0)/1000).toFixed(1);\n    if(r.ok && (d.reply||d.output)){ $('health').className='pill ok'; $('healthTxt').textContent='فرح: حيّة · '+secs+' ث'; logEvent('فرح ردّت على الفحص: '+String(d.reply||d.output).slice(0,60)); }\n    else throw new Error('HTTP '+r.status);\n  }catch(e){ $('health').className='pill bad'; $('healthTxt').textContent='فرح: لا ترد'; logEvent('فشل الفحص: '+(e.message||e)); }\n};\n\n// Speech input. Works in Chrome/Edge/Safari on a real https tab (this page is served over https from n8n).\nconst SR=window.SpeechRecognition||window.webkitSpeechRecognition; let rec=null, recording=false, holdMode=false;\nfunction showMicHint(t){ micHint.textContent=t; micHint.hidden=false; }\nfunction setMicState(t){ $('micState').textContent='المايك: '+t; }\nif(!SR){ mic.disabled=true; showMicHint('هذا المتصفح لا يدعم التعرّف على الصوت. افتح الرابط في Chrome أو Edge أو Safari؛ الكتابة والنطق يعملان الآن.'); }\nfunction startListening(){\n  if(!SR || recording || busy) return;\n  stopSpeaking();\n  try{\n    rec=new SR(); rec.lang='ar-SA'; rec.interimResults=true; rec.continuous=holdMode; rec.maxAlternatives=1;\n    let finalText='';\n    rec.onstart=()=>{ recording=true; mic.classList.add('rec'); micHint.hidden=true; setMicState(holdMode?'يسجّل — ارفع إصبعك لتُرسل':'يستمع…'); $('lvl').style.width='60%'; };\n    rec.onresult=e=>{ let s=''; for(const r of e.results){ s+=r[0].transcript; if(r.isFinal) finalText=s; } input.value=s; $('lvl').style.width=(40+Math.min(60,s.length))+'%'; };\n    rec.onerror=e=>{ recording=false; mic.classList.remove('rec'); $('lvl').style.width='0'; setMicState('خطأ: '+e.error);\n      if(e.error==='not-allowed'||e.error==='service-not-allowed'){ showMicHint('المتصفح رفض المايك. اضغط على القفل بجانب الرابط واسمح بالميكروفون، ثم أعد المحاولة.'); handsFree=false; renderHands(); }\n      else if(e.error==='no-speech'){ setMicState('ما سمعت شيئاً'); if(handsFree) setTimeout(()=>startListening(),600); }\n      logEvent('خطأ المايك: '+e.error); };\n    rec.onend=()=>{ recording=false; mic.classList.remove('rec'); $('lvl').style.width='0'; setMicState('جاهز');\n      const v=(finalText||input.value).trim();\n      if(v){ input.value=''; if(/^(توقف|توقفي|اسكت|اسكتي|كفاية|خلاص)[.!]?$/.test(v)){ handsFree=false; renderHands(); stopSpeaking(); addMsg('sys','','توقف وضع جارفس.'); return; } send(v); }\n      else if(handsFree && !busy) setTimeout(()=>startListening(),500); };\n    rec.start();\n  }catch(e){ showMicHint('تعذّر تشغيل المايك: '+(e.message||e)); }\n}\nlet pressTimer=null;\nmic.addEventListener('pointerdown',e=>{ if(!SR) return; e.preventDefault(); pressTimer=setTimeout(()=>{ holdMode=true; startListening(); },350); });\nmic.addEventListener('pointerup',e=>{ if(!SR) return; e.preventDefault(); if(pressTimer){ clearTimeout(pressTimer); pressTimer=null; }\n  if(holdMode){ holdMode=false; if(recording) try{rec.stop()}catch{} return; }\n  if(recording){ try{rec.stop()}catch{} } else startListening(); });\nmic.addEventListener('pointerleave',()=>{ if(pressTimer){ clearTimeout(pressTimer); pressTimer=null; } });\ndocument.addEventListener('keydown',e=>{ if(e.code==='Space' && document.activeElement!==input && !e.repeat){ e.preventDefault(); if(recording) try{rec.stop()}catch{} else startListening(); } });\n\nif('speechSynthesis' in window){ try{ speechSynthesis.onvoiceschanged=()=>{}; speechSynthesis.getVoices(); }catch{} }\n\n// ---------- Map ----------\nconst svg=$('map'); const NS='http://www.w3.org/2000/svg';\nconst CX=500, CY=350, R=300;\nconst nodeEls={}, linkEls={}, chordEls={};\nfunction el(tag,attrs,parent){ const e=document.createElementNS(NS,tag); for(const k in attrs) e.setAttribute(k,attrs[k]); if(parent) parent.appendChild(e); return e; }\nfunction renderMap(){\n  svg.innerHTML='';\n  const ring=AGENTS.filter(a=>a.id!=='farah');\n  const n=ring.length;\n  const gw=el('g',{},svg), gl=el('g',{},svg), gn=el('g',{},svg);\n  // spider web: three concentric rings + radial threads\n  [0.33,0.66,1].forEach(k=>el('ellipse',{class:'web',cx:CX,cy:CY,rx:R*1.35*k,ry:R*0.86*k},gw));\n  ring.forEach((a,i)=>{\n    const ang=-Math.PI/2 + (i/n)*Math.PI*2;\n    const x=CX+Math.cos(ang)*R*1.35, y=CY+Math.sin(ang)*R*0.86;\n    a._x=x; a._y=y;\n    const mx=(CX+x)/2 + Math.cos(ang+Math.PI/2)*18, my=(CY+y)/2 + Math.sin(ang+Math.PI/2)*18;\n    linkEls[a.id]=el('path',{d:`M${CX},${CY} Q${mx},${my} ${x},${y}`,class:'link'},gl);\n    const g=el('g',{class:'node',transform:`translate(${x},${y})`},gn); g.dataset.id=a.id; nodeEls[a.id]=g;\n    el('circle',{class:'halo',r:26,fill:'none',stroke:'var(--work)','stroke-width':1.5,opacity:0},g);\n    el('circle',{class:'core',r:27},g);\n    const t=el('text',{class:'init',y:5},g); t.textContent=a.name.slice(0,1);\n    const nm=el('text',{y:46},g); nm.textContent=a.name;\n    const sub=el('text',{class:'sub',y:60},g); sub.textContent=a.role.length>26?a.role.slice(0,25)+'…':a.role;\n    const cnt=el('text',{class:'cnt',x:-22,y:-22},g); cnt.textContent='';\n    // satellites: team members\n    const team=(a.team||'').split('·').map(s=>s.trim()).filter(s=>s&&!/^(تدير|تعمل|يوجّه)/.test(s));\n    team.forEach((m,j)=>{ const sa=-Math.PI/2+(j/Math.max(team.length,1))*Math.PI*2; const c=el('circle',{class:'sat',cx:Math.cos(sa)*36,cy:Math.sin(sa)*36,r:3.4},g); const tt=el('title',{},c); tt.textContent=m; });\n    g.addEventListener('click',()=>selectAgent(a.id));\n  });\n  // chords: every department can consult every other one (Consult Colleague) — the web itself\n  for(let i=0;i<ring.length;i++) for(let j=i+1;j<ring.length;j++){ const a=ring[i], b=ring[j]; const c=el('path',{d:`M${a._x},${a._y} Q${CX},${CY} ${b._x},${b._y}`,class:'chord'},gw); chordEls[a.id+'|'+b.id]=c; chordEls[b.id+'|'+a.id]=c; }\n  const f=AGENTS.find(a=>a.id==='farah'); f._x=CX; f._y=CY;\n  const c=el('g',{class:'center node',transform:`translate(${CX},${CY})`},gn); c.dataset.id='farah'; nodeEls.farah=c;\n  el('circle',{r:50},c); const ft=el('text',{y:-2},c); ft.textContent='فرح'; const fs=el('text',{class:'sub',y:14},c); fs.textContent='رئيسة المكتب التنفيذي';\n  c.addEventListener('click',()=>selectAgent('farah'));\n  applySel();\n}\nfunction applySel(){ Object.keys(nodeEls).forEach(id=>{ nodeEls[id].classList.toggle('sel',id===selected); if(linkEls[id]) linkEls[id].classList.toggle('sel',id===selected); }); }\nfunction selectAgent(id){ selected=id; try{localStorage.setItem('jarvis.agent',id)}catch{} applySel(); renderWho(); const a=AGENTS.find(x=>x.id===id); addMsg('sys','','تحوّلت المحادثة إلى '+a.name+' — '+a.role); showTab('chat'); }\nfunction renderWho(){\n  const a=AGENTS.find(x=>x.id===selected)||AGENTS[0]; const p=lastPulse&&lastPulse.agents&&pulseFor(a.id);\n  const team=(a.team||'').split('·').map(s=>s.trim()).filter(Boolean);\n  $('whoCard').innerHTML=`<h3></h3><p class=\"rl\"></p><div class=\"team\"></div><p class=\"ld\"></p>`;\n  $('whoCard').querySelector('h3').textContent=a.name+(a.id==='farah'?'':' ← عبر فرح');\n  $('whoCard').querySelector('.rl').textContent=a.role;\n  const tm=$('whoCard').querySelector('.team'); team.forEach(m=>{ const s=document.createElement('span'); s.textContent=m; tm.appendChild(s); });\n  $('whoCard').querySelector('.ld').textContent=p?`${p.open||0} مهمة مفتوحة · ${p.in_progress||0} قيد التنفيذ${p.latest_objective?' · آخر مهمة: '+p.latest_objective:''}`:'لا بيانات نبض بعد';\n}\nfunction setWork(id,on){ const g=nodeEls[id]; if(!g) return; g.classList.toggle('busy',on); if(linkEls[id]) linkEls[id].classList.toggle('busy',on); }\nfunction clearDone(){}\n// ---------- Pulse ----------\nlet pulseTimer=null, lastPulse=null;\nfunction pulseFor(id){ if(!lastPulse) return null; for(const raw of Object.keys(lastPulse.agents)){ if((PULSE_MAP[raw]||PULSE_MAP[raw.toLowerCase()])===id) return lastPulse.agents[raw]; } return null; }\nasync function pulse(){\n  try{\n    const r=await fetch(PULSE,{cache:'no-store'}); const d=await r.json(); if(!d||!d.agents) throw new Error('no data');\n    lastPulse=d;\n    AGENTS.forEach(a=>{ const p=pulseFor(a.id); const g=nodeEls[a.id]; if(!g) return;\n      const busy=!!(p&&(p.in_progress||0)>0); if(!busy||!g.classList.contains('busy')) g.classList.toggle('busy',busy); if(linkEls[a.id]) linkEls[a.id].classList.toggle('busy',busy);\n      g.classList.toggle('paused',!!(p&&(p.enabled===false||p.status==='paused')));\n      const cnt=g.querySelector('.cnt'); if(cnt) cnt.textContent=p&&p.open?String(p.open):''; });\n    const t=d.totals||{}; $('kActive').textContent=t.active??'—'; $('kProg').textContent=t.in_progress??0; $('kOpen').textContent=t.open??0; $('kNeeds').textContent=t.needs_owner??(d.needs_owner||[]).length; $('kPaused').textContent=t.paused??0;\n    renderNeeds(d.needs_owner||[]);\n    $('pulseTxt').textContent=`نبض حي · ${new Date(d.at).toLocaleTimeString('ar-SA',{hour:'2-digit',minute:'2-digit'})}`; $('pulse').className='pill ok';\n    renderWho();\n  }catch(e){ $('pulse').className='pill bad'; $('pulseTxt').textContent='النبض متوقف: '+(e.message||e); }\n}\nfunction startPulse(){ pulse(); if(pulseTimer) clearInterval(pulseTimer); pulseTimer=setInterval(pulse,30000); }\ndocument.addEventListener('visibilitychange',()=>{ if(document.hidden){ clearInterval(pulseTimer); pulseTimer=null; } else startPulse(); });\nfunction renderNeeds(list){\n  const box=$('needs'); box.innerHTML=''; $('needsBadge').textContent=list.length?`(${list.length})`:'';\n  if(!list.length){ box.innerHTML='<div class=\"empty\">ما عليك شيء الآن — الفريق ماسكها.</div>'; return; }\n  list.forEach(t=>{ const d=document.createElement('div'); d.className='need';\n    d.innerHTML=`<b></b><p></p><small></small><div class=\"act\"><button type=\"button\" class=\"done\">خلصت ✓</button><button type=\"button\" class=\"ask\">اسألي فرح عنها</button></div>`;\n    d.querySelector('b').textContent=t.objective||t.task_id; d.querySelector('p').textContent=t.next_action||''; d.querySelector('small').textContent=`${t.task_id} · ${t.priority||''} · من ${t.created_by||'—'}`;\n    d.querySelector('.done').onclick=()=>{ selected='farah'; applySel(); renderWho(); showTab('chat'); send(`خلصت المهمة ${t.task_id} (${(t.objective||'').slice(0,60)}). أغلقيها بـ Complete Human Task، فكّي أي Human Gate مرتبطة، واستأنفي الفريق، وقولي لي وش الخطوة التالية عندهم.`); };\n    d.querySelector('.ask').onclick=()=>{ selected='farah'; applySel(); renderWho(); showTab('chat'); send(`اشرحي لي المهمة ${t.task_id} باختصار: وش المطلوب مني بالضبط وليش، وما البديل لو ما سويتها؟`); };\n    box.appendChild(d); });\n}\nfunction showTab(name){ document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.tab===name)); document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.id==='tab-'+name)); }\ndocument.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>showTab(b.dataset.tab));\nrenderMap(); renderWho();\naddMsg('sys','','جاهز. اضغط على أي شخص في الخارطة ثم اكتب أو تكلّم (مسافة = مايك). الأصفر والخط المتحرك = يعمل الآن فعلاً. تبويب «يحتاجونك» يقرأ من جدول المهام مباشرة.');\nif(handsFree) addMsg('sys','','وضع جارفس محفوظ من آخر مرة — اضغط المايك مرة واحدة ليبدأ.');\nstartPulse();\n\n</script>\n</body>\n</html>\n"},"notes":"صفحة جارفس (خارطة الفريق) تُخدَم من n8n مباشرة على https ليعمل المايك. المصدر في جلسة Claude (jarvis-map.html) لا في المستودع لأنه يحمل مسارات ويبهوك سرّية."}],"nodeGroups":[],"activeVersion":{"sameAsDraft":true},"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"}},"triggerInfo":"This workflow has the following trigger(s):\n\n\nWebhook trigger(s):\n\n\n\t\t\t\t<trigger 1>\n\t\t\t\t\t - Node name: Voice POST\n\t\t\t\t\t - Production URL: https://businesspartnerai.app.n8n.cloud/webhook/jarvis-voice-***REDACTED***\n\t\t\t\t\t - Test URL: https://businesspartnerai.app.n8n.cloud/webhook-test/jarvis-voice-***REDACTED***\n\t\t\t\t\t - HTTP Method: POST\n\t\t\t\t\t - Response Mode: Webhook is configured to respond using \"Respond to Webhook\" node.\n\t\t\t\t\t - No credentials required for this webhook.\n\t\t\t\t</trigger 1>\n\n\n\t\t\t\t<trigger 2>\n\t\t\t\t\t - Node name: Jarvis Page GET\n\t\t\t\t\t - Production URL: https://businesspartnerai.app.n8n.cloud/webhook/jarvis-map-***REDACTED***\n\t\t\t\t\t - Test URL: https://businesspartnerai.app.n8n.cloud/webhook-test/jarvis-map-***REDACTED***\n\t\t\t\t\t - HTTP Method: GET\n\t\t\t\t\t - Response Mode: Webhook is configured to respond using \"Respond to Webhook\" node.\n\t\t\t\t\t - No credentials required for this webhook.\n\t\t\t\t</trigger 2>\n\nTo execute a webhook trigger, pass triggerNodeName and inputs: { triggerNodeName: \"<node name>\", inputs: { webhookData: { headers?, query?, body? } } }."}