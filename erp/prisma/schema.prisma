  /// فُوترت ضمن فاتورة
  invoiced Boolean @default(false)

  /// DRAFT | SUBMITTED | APPROVED | REJECTED
  status     String    @default("DRAFT")
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, employeeId, date])
  @@index([tenantId, projectId])
}

// ═══════════════════════════════════ الأصول الثابتة والاستهلاك ══════════════

/// STRAIGHT_LINE القسط الثابت | DECLINING_BALANCE القسط المتناقص
/// | UNITS_OF_PRODUCTION وحدات الإنتاج
enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  UNITS_OF_PRODUCTION
}

/// الأصل الثابت.
///
/// قيمته الدفترية = التكلفة − مجمَّع الاستهلاك، وكلاهما محفوظ هنا ومُرحَّل
/// في الأستاذ. لماذا يُحفظ ما هو مشتقّ؟ لأن الاستهلاك يُحسب شهرياً على
/// الرصيد المتبقّي في طريقة القسط المتناقص، وإعادة اشتقاقه من الدفتر في كل
/// تشغيل يجعل كل شهر يعيد قراءة تاريخ الأصل كلّه. والتسوية تكشف أي انحراف.
model FixedAsset {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code   String
  nameAr String
  nameEn String?
  descAr String?

  categoryAr   String?
  serialNumber String?
  location     String?

  /// تاريخ الشراء وتاريخ بدء الاستهلاك — قد يختلفان (أصل اشتُري ولم يُشغَّل)
  purchaseDate  DateTime @db.Date
  inServiceDate DateTime @db.Date

  /// التكلفة التاريخية بلا ضريبة
  cost             Decimal @db.Decimal(18, 6)
  /// القيمة التخريدية المتوقَّعة في نهاية العمر
  salvageValue     Decimal @default(0) @db.Decimal(18, 6)
  /// العمر الإنتاجي بالأشهر
  usefulLifeMonths Int

  method          DepreciationMethod @default(STRAIGHT_LINE)
  /// معامل التناقص (٢ = القسط المتناقص المضاعف). للطريقة المتناقصة فقط.
  decliningFactor Decimal            @default(2) @db.Decimal(9, 4)

  /// إجمالي وحدات الإنتاج المتوقَّعة — لطريقة وحدات الإنتاج
  totalUnits Decimal? @db.Decimal(18, 6)
  unitsUsed  Decimal  @default(0) @db.Decimal(18, 6)

  /// مجمَّع الاستهلاك حتى تاريخه
  accumulated       Decimal   @default(0) @db.Decimal(18, 6)
  /// آخر شهر استُهلك فيه — يمنع الاستهلاك مرّتين للشهر نفسه
  lastDepreciatedOn DateTime? @db.Date

  /// حسابات الترحيل: الأصل، ومجمَّع الاستهلاك، ومصروف الاستهلاك
  assetAccountId       String?
  accumulatedAccountId String?
  expenseAccountId     String?

  costCenterId String?
  projectId    String?

  /// ACTIVE قيد الاستخدام | FULLY_DEPRECIATED مستهلك بالكامل
  /// | DISPOSED مستبعَد | SOLD مُباع
  status String @default("ACTIVE")

  disposalDate     DateTime? @db.Date
  disposalProceeds Decimal?  @db.Decimal(18, 6)
  disposalNote     String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries DepreciationEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

/// سطر استهلاك شهري لأصل. سجلٌّ لكل شهر ولكل أصل، فيُقرأ تاريخ الأصل كاملاً
/// ويُمنع تكرار الشهر بقيد التفرّد.
model DepreciationEntry {
  id       String     @id @default(cuid())
  tenantId String
  assetId  String
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  runId String?
  run   DepreciationRun? @relation(fields: [runId], references: [id])

  /// أول يوم من الشهر المستهلَك — مفتاح التفرّد
  period DateTime @db.Date

  amount         Decimal @db.Decimal(18, 6)
  /// القيمة الدفترية بعد هذا القسط
  bookValueAfter Decimal @db.Decimal(18, 6)

  journalEntryId String?
  createdAt      DateTime @default(now())

  @@unique([assetId, period])
  @@index([tenantId, period])
}

/// تشغيل استهلاك شهري يشمل كل الأصول المستحقّة — قيدٌ واحد بمجاميعه.
model DepreciationRun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  number  String
  year    Int
  month   Int
  runDate DateTime @db.Date

  /// DRAFT | POSTED | CANCELLED
  status String @default("DRAFT")

  assetCount  Int     @default(0)
  totalAmount Decimal @default(0) @db.Decimal(18, 6)

  journalEntryId String? @unique

  postedAt  DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries DepreciationEntry[]

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
}

// ══════════════════════════════════════ الإقفال السنوي ══════════════════════

/// إقفال سنة مالية.
///
/// يغلق حسابات الإيرادات والمصروفات في الأرباح المبقاة، ثم يقفل فترات السنة
/// قفلاً نهائياً. ويُحفظ سجلّه لأن الإقفال يُعكس أحياناً — تُكتشف فاتورة
/// متأخّرة بعد الإقفال — فيجب أن يُعرف ما فُعل بالضبط ليُرجَع عنه.
model YearEndClosing {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fiscalYearId String     @unique
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  closingDate DateTime @db.Date

  /// صافي ربح السنة المُقفَل
  netProfit      Decimal @db.Decimal(18, 6)
  /// عدد الحسابات المُقفَلة
  accountsClosed Int     @default(0)

  /// قيد الإقفال، وقيد العكس إن رُجع عن الإقفال
  closingEntryId  String? @unique
  reversalEntryId String? @unique

  /// POSTED مُقفَلة | REVERSED رُجع عنها
  status String @default("POSTED")

  closedBy   String?
  reversedAt DateTime?
  reversedBy String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ═══════════════════════════════ إعادة تقييم العملات ════════════════════════

/// إعادة تقييم أرصدة العملات الأجنبية في نهاية الفترة.
///
/// الرصيد بالعملة الأجنبية ثابت، وقيمته بعملة الدفاتر تتغيّر مع سعر الصرف.
/// الفرق غير محقَّق حتى يُسدَّد، لكن المعايير توجب إظهاره في القوائم — فيُقيَّد
/// ربحاً أو خسارة غير محقَّقة، ويُعكس في أول اليوم التالي كي لا يتراكم.
model FxRevaluation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  number        String
  valuationDate DateTime @db.Date

  /// DRAFT | POSTED | REVERSED
  status String @default("DRAFT")

  /// صافي الفرق: موجب ربحٌ غير محقَّق، سالب خسارة
  netDifference Decimal @default(0) @db.Decimal(18, 6)
  accountCount  Int     @default(0)

  journalEntryId  String? @unique
  reversalEntryId String? @unique

  /// هل يُعكس تلقائياً في اليوم التالي؟ الافتراضي نعم — وإلا تراكمت الفروق
  autoReverse Boolean @default(true)

  postedAt  DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  lines FxRevaluationLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model FxRevaluationLine {
  id            String        @id @default(cuid())
  revaluationId String
  revaluation   FxRevaluation @relation(fields: [revaluationId], references: [id], onDelete: Cascade)
  tenantId      String

  accountId String
  currency  String

  /// الرصيد بالعملة الأجنبية
  foreignBalance Decimal @db.Decimal(18, 6)
  /// قيمته الدفترية الحالية بعملة الدفاتر
  bookValue      Decimal @db.Decimal(18, 6)
  /// سعر الصرف المستعمل في إعادة التقييم
  rate           Decimal @db.Decimal(18, 9)
  /// القيمة بعد إعادة التقييم
  revaluedValue  Decimal @db.Decimal(18, 6)
  /// الفرق = المُعاد تقييمه − الدفتري
  difference     Decimal @db.Decimal(18, 6)

  @@index([revaluationId])
  @@index([tenantId])
}

// ═══════════════════════════════════ التسوية البنكية ════════════════════════

/// كشف حساب بنكي مستورد.
model BankStatement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  reference String?
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date

  /// الرصيد الافتتاحي والختامي كما في الكشف — بهما تُثبت صحة الاستيراد
  openingBalance Decimal @db.Decimal(18, 6)
  closingBalance Decimal @db.Decimal(18, 6)

  /// IMPORTED مستورد | RECONCILING قيد التسوية | RECONCILED مُسوّى
  status String @default("IMPORTED")

  reconciledAt DateTime?
  reconciledBy String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BankStatementLine[]

  @@index([tenantId, bankAccountId])
  @@index([tenantId, status])
}

/// سطر في كشف الحساب. يُطابَق بسطر واحد من الدفتر أو يبقى معلّقاً.
model BankStatementLine {
  id          String        @id @default(cuid())
  statementId String
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  tenantId    String

  valueDate DateTime @db.Date
  descRaw   String
  reference String?

  /// موجب وارد، سالب صادر — كما في الكشف
  amount         Decimal  @db.Decimal(18, 6)
  /// الرصيد الجاري كما في الكشف، إن ورد
  runningBalance Decimal? @db.Decimal(18, 6)

  /// UNMATCHED غير مطابق | MATCHED مطابق | IGNORED مستبعَد
  status String @default("UNMATCHED")

  /// سطر الدفتر المطابق
  journalLineId String?   @unique
  /// درجة ثقة المطابقة الآلية من ١٠٠ — دون العتبة تحتاج تأكيداً بشرياً
  matchScore    Int?
  matchedBy     String?
  matchedAt     DateTime?

  /// قيد تسوية أُنشئ لهذا السطر حين لا يوجد ما يقابله (رسوم بنكية مثلاً)
  adjustmentEntryId String?

  sortOrder Int @default(0)

  @@index([statementId, status])
  @@index([tenantId])
}
