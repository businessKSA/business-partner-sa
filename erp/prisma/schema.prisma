model Payslip {
  id       String     @id @default(cuid())
  runId    String
  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenantId String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  basicSalary        Decimal @default(0) @db.Decimal(18, 6)
  housingAllowance   Decimal @default(0) @db.Decimal(18, 6)
  transportAllowance Decimal @default(0) @db.Decimal(18, 6)
  otherAllowance     Decimal @default(0) @db.Decimal(18, 6)
  overtimeAmount     Decimal @default(0) @db.Decimal(18, 6)
  bonus              Decimal @default(0) @db.Decimal(18, 6)

  gross Decimal @default(0) @db.Decimal(18, 6)

  /// حصة الموظف من التأمينات — تُخصم من أجره
  gosiEmployee Decimal @default(0) @db.Decimal(18, 6)
  /// حصة صاحب العمل — تكلفة على المنشأة لا خصم على الموظف
  gosiEmployer Decimal @default(0) @db.Decimal(18, 6)

  /// خصم الغياب والتأخير والسلف
  absenceDeduction Decimal @default(0) @db.Decimal(18, 6)
  loanDeduction    Decimal @default(0) @db.Decimal(18, 6)
  otherDeduction   Decimal @default(0) @db.Decimal(18, 6)

  totalDeductions Decimal @default(0) @db.Decimal(18, 6)
  net             Decimal @default(0) @db.Decimal(18, 6)

  /// أيام العمل الفعلية وأيام الغياب في الشهر
  workedDays    Decimal @default(30) @db.Decimal(9, 2)
  absentDays    Decimal @default(0) @db.Decimal(9, 2)
  overtimeHours Decimal @default(0) @db.Decimal(9, 2)

  notes String?

  createdAt DateTime @default(now())

  @@unique([runId, employeeId])
  @@index([tenantId, employeeId])
}

// ══════════════════════════════════════ المشاريع والوقت ═════════════════════

model Project {
