  annualDays    Int     @default(0)
  /// تُخصم من رصيد الإجازة السنوية
  deductsAnnual Boolean @default(false)

  createdAt DateTime       @default(now())
  requests  LeaveRequest[]

  @@unique([tenantId, code])
