  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code   String
  nameAr String
  nameEn String?
  descAr String?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

