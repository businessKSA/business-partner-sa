/// مسيّر رواتب شهري. الترحيل يولّد قيداً واحداً بمجاميع المسيّر، والقسائم
/// تفصيله.
model PayrollRun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  number String
  year   Int
  month  Int

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  payDate     DateTime @db.Date

  /// DRAFT | APPROVED | POSTED | PAID | CANCELLED
  status String @default("DRAFT")

  totalGross        Decimal @default(0) @db.Decimal(18, 6)
  totalDeductions   Decimal @default(0) @db.Decimal(18, 6)
  totalGosiEmp      Decimal @default(0) @db.Decimal(18, 6)
  totalGosiEmployer Decimal @default(0) @db.Decimal(18, 6)
  totalNet          Decimal @default(0) @db.Decimal(18, 6)

