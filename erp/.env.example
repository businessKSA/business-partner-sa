# ─────────────────────────────────────────────────────────── قاعدة البيانات
# الدور هنا يجب ألّا يكون SUPERUSER ولا يحمل BYPASSRLS: كلاهما يتخطّى
# سياسات عزل الصفوف إعفاءً تاماً، فتبقى معرَّفةً ولا تُطبَّق، ويصير كل
# عملاء المنصة في دفتر واحد بلا أي علامة على الشاشة.
DATABASE_URL="postgresql://erp:CHANGE_ME@localhost:5432/erp"
# رابط مباشر بلا تجميع اتصالات — لأوامر الترحيل وحدها
DIRECT_DATABASE_URL="postgresql://erp:CHANGE_ME@localhost:5432/erp"

# ─────────────────────────────────────────────────────────────── التطبيق
APP_URL="http://localhost:3100"

# سرّ توقيع الجلسات — ٣٢ محرفاً على الأقل
# ولّده بـ: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+"

# مفتاح تشفير الأسرار المخزَّنة (مفتاح توقيع زاتكا الخاص ورموز الشهادات).
# تغييره يجعل ما شُفِّر به غير قابل للفكّ — احفظه واحفظ نسخته الاحتياطية.
# ولّده بـ: openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+"

# ─────────────────────────────────────────── حساب مالك المنصة في البذرة
# للتطوير المحلي تُترك فارغة، فتُستعمل القيم الثابتة في prisma/seed.ts.
# أمّا في أي بيئةٍ منشورة (يُكتشف وجود VERCEL، أو اضبط SEED_REQUIRE_ENV=1)
# فالبذرة **ترفض العمل** بدونها: كلمة سرٍّ مكتوبة في المستودع تعني أن كل
# من قرأ المستودع يملك لوحة المنصة، وهي التي تُنشئ منشآت العملاء وتحذفها.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_ACCOUNTANT_EMAIL=""

# ───────────────────────────────────── هيئة الزكاة والضريبة والدخل
# SANDBOX اختبار | SIMULATION محاكاة | PRODUCTION إنتاج
# البيئة تُضبط لكل منشأة على حدة من إعدادات الفوترة؛ هذه القيمة افتراضٌ أوّلي.
ZATCA_ENV="SANDBOX"

# ─────────────────────────────────────────────────────── اختبار الدخان
E2E_BASE="http://localhost:3100"
E2E_EMAIL="admin@businesspartner.sa"
E2E_PASSWORD="BP-erp-2026"
# مسار متصفّح Chromium لتشغيل e2e
CHROMIUM_PATH="/opt/pw-browsers/chromium"
