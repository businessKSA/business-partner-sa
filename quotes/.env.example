# ------------------------------------------------------------------ الأساسيات
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# رابط مباشر بلا تجميع اتصالات — تستخدمه أوامر الترحيل فقط
DIRECT_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
APP_URL="http://localhost:3000"
# سر توقيع جلسات لوحة التحكم وبوابة العميل (غيّره في الإنتاج)
SESSION_SECRET="change-me-to-a-long-random-string"

# ------------------------------------------------------------ دخول لوحة التحكم
# بريدك فقط — أي بريد آخر يُرفض. رابط الدخول يصلك بالبريد (Magic Link).
ADMIN_EMAIL="Business@businesspartnerksa.com"
# في بيئة التطوير يُعرض رابط الدخول على الشاشة بدل إرساله بالبريد
DEV_SHOW_MAGIC_LINK="1"

# ------------------------------------------------------------------ البريد
# MAIL_PROVIDER = smtp | resend | log
MAIL_PROVIDER="log"
MAIL_FROM="Business Partner Solutions <Business@businesspartnerksa.com>"
# إشعاراتي عند القبول والتوقيع والدفع
NOTIFY_EMAIL="Business@businesspartnerksa.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# ------------------------------------------------------------------ التخزين
# STORAGE_DRIVER = local | s3   (الإنتاج على Vercel يتطلب s3 — القرص مؤقت)
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage"
# على Vercel: القرص للقراءة فقط، فالجذر الافتراضي /tmp/storage تلقائياً.
# التخزين المؤقت للتجربة فقط — الأرشفة الدائمة تحتاج STORAGE_DRIVER=s3.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
# صلاحية روابط التنزيل الموقّعة بالثواني
S3_SIGNED_URL_TTL="900"

# ------------------------------------------------------------ طابور المهام
# QUEUE_DRIVER = inline | inngest
#   inline  = التنفيذ داخل الطلب (تطوير محلي فقط)
#   inngest = طابور مُدار يعمل على Vercel بلا خادم دائم
QUEUE_DRIVER="inline"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ------------------------------------------------------------- توليد المستندات
# PDF_DRIVER = local | serverless
#   local      = متصفح Chromium مثبّت على الجهاز
#   serverless = @sparticuz/chromium داخل دالة Vercel
PDF_DRIVER="local"
CHROMIUM_PATH=""
# الرابط الداخلي الذي يفتحه المتصفح لطباعة المستند
INTERNAL_URL=""

# ------------------------------------------------------------ الوكيل الذكي
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-opus-5"

# ---------------------------------------------------------------- DocuSign
# DOCUSIGN_MODE = demo | production | mock
# mock = محاكاة محلية كاملة لدورة التوقيع بدون حساب DocuSign (للاختبار)
DOCUSIGN_MODE="mock"
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_AUTH_BASE="account-d.docusign.com"
DOCUSIGN_API_BASE="https://demo.docusign.net/restapi"
# المفتاح الخاص RSA بصيغة PEM. إما مسار ملف أو المحتوى نفسه بأسطر \n
DOCUSIGN_PRIVATE_KEY_PATH="./secrets/docusign_private.key"
DOCUSIGN_PRIVATE_KEY=""
# سر HMAC لتوقيع Webhook (DocuSign Connect)
DOCUSIGN_CONNECT_HMAC_KEY=""

# --------------------------------------------------------------- الدفع
# PAYMENT_PROVIDER = moyasar | mock
PAYMENT_PROVIDER="mock"
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
# إلزامي مع PAYMENT_PROVIDER=moyasar — نفس الرمز المضبوط في webhook لوحة التاجر.
# بدونه تُرفض كل نداءات الـwebhook حتى لا تُعلَن فاتورة مدفوعة بلا تحقق.
MOYASAR_WEBHOOK_SECRET=""
# نسخة نموذج Moyasar على شبكة التوزيع — تُرفَع هنا دون تعديل الكود.
MOYASAR_FORM_VERSION="1.7.3"
# آبل باي يتطلب توثيق النطاق لدى Moyasar أولاً. اضبطه على 1 بعد التوثيق.
MOYASAR_APPLE_PAY="0"

# ---------------------------------------------------------------- واتساب
# WHATSAPP_MODE = link | api  (api جاهز للتفعيل عند توفر WhatsApp Business API)
WHATSAPP_MODE="link"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# ---------------------------------------------------------------- دفترة
# نظام المحاسبة الرسمي — مصدر الفاتورة الضريبية المعتمدة لدى هيئة الزكاة
# والضريبة والجمارك. لا يُرحَّل شيء إلى دفترة ما لم يكن DAFTRA_MODE=live،
# حمايةً من ازدواج الفواتير مع أي تكامل قائم على الحساب نفسه.
# DAFTRA_MODE = off | live
DAFTRA_MODE="off"
DAFTRA_SUBDOMAIN="businesspartner"
DAFTRA_API_KEY=""
# يُضبطان بعد نجاح /api/daftra/probe (فحص محمي بجلسة المدير)
DAFTRA_API_BASE="/api2"
DAFTRA_API_HEADER="APIKEY"
