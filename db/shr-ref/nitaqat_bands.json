{
 "_meta": {
  "schema": "shr-hr/compliance/nitaqat/v1",
  "generated_on": "2026-10-23",
  "program_ar": "برنامج نطاقات المطور",
  "decision_ref": "القرار الوزاري 182495 (يرد اسمه في الدليل المنشور 22-يناير-2026)",
  "verification_ar": "المعادلة والأنشطة والقيم استُخرجت من طبقة النص في PDF الدليل الرسمي (مارس 2026) وقورنت آلياً بجدول باحث المبيعات: 164 قيمة (41 نشاطاً × 4 نطاقات × م وث 2026/2027/2028) مطابقة بلا فروق. لم أقارن نسخة يناير 2026 (يُقال إن صياغة المعادلة فيها تختلف قليلاً).",
  "formula": {
   "text_ar": "ص = م × لوغ(س) + ث",
   "ln": "natural log",
   "s_ar": "س = إجمالي عمالة الكيان",
   "p_ar": "ص = النسبة الدنيا للنطاق؛ تُحسب لأربعة نطاقات (أخضر منخفض، متوسط، مرتفع، بلاتيني)",
   "pseudo": "min_pct[band] = m[band] * ln(total_workforce) + c[band][year]",
   "source_url": "https://www.hrsd.gov.sa/sites/default/files/2026-03/ntaqat-almtwr.pdf",
   "source_ref": "الدليل 2026، ص4",
   "verified": "confirmed",
   "verified_on": "2026-10-23"
  },
  "localization_ratio": {
   "text_ar": "مجموع متوسطات العمالة السعودية بمنشآت الكيان ÷ (مجموع متوسطات السعودية + مجموع متوسطات الوافدة) × 100",
   "source_url": "https://www.hrsd.gov.sa/sites/default/files/2026-03/ntaqat-almtwr.pdf",
   "source_ref": "الدليل 2026، ص3 (التعريفات)",
   "verified": "confirmed",
   "verified_on": "2026-10-23"
  },
  "band_assignment": {
   "text_ar": "ن < ص(أخضر منخفض) ← أحمر؛ ص(منخفض) ≤ ن < ص(متوسط) ← أخضر منخفض؛ ص(متوسط) ≤ ن < ص(مرتفع) ← أخضر متوسط؛ ص(مرتفع) ≤ ن < ص(بلاتيني) ← أخضر مرتفع؛ ن ≥ ص(بلاتيني) ← بلاتيني",
   "source_url": "https://www.hrsd.gov.sa/sites/default/files/2026-03/ntaqat-almtwr.pdf",
   "source_ref": "الدليل 2026، ص5",
   "verified": "confirmed",
   "verified_on": "2026-10-23",
   "caution_ar": "نص الدليل المطبوع يكتب «ن > ص» في الأحمر و«>=» في البقية بصياغة قد تنقلب في الاستخراج النصي؛ المعتمد هنا قراءة الباحث وهي منطقية (الحد الأدنى للنطاق شاملٌ لنفسه) — يُراجَع على الصورة قبل الحسم في الحافة بالضبط."
  },
  "band_names_ar": [
   "أحمر",
