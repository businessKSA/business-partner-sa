# أسرار محلية فقط. لا تُرفع إلى git.
ANTHROPIC_API_KEY=
# معرّف الخزنة (vault) التي تحمل اعتمادات نوشن وGitHub وn8n. ينشئها scripts/vault.sh
VAULT_ID=
# توكن GitHub دقيق الصلاحيات (Contents: Read and write, Pull requests: Read and write) على businessKSA/business-partner-sa
GITHUB_TOKEN=
# مفتاح رأس X-BP-Agent-Key الذي يحرس webhook bp-agent-send في n8n
BP_N8N_HOOK_KEY=
# رقم المالك الدولي لاستقبال الخلاصات على واتساب
OWNER_WHATSAPP=
# مساحة العمل في Console لطباعة رابط الجلسة (default إن كان المفتاح في المساحة الافتراضية)
ANTHROPIC_WORKSPACE=default
