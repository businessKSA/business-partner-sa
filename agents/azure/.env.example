# فريق Business Partner على Azure — أسرار محلية فقط، لا تُرفع إلى git.
# في الإنتاج تُوضع كـsecrets في Azure Container Apps (انظر deploy.sh)، لا هنا.

# ——— المحرّك (Azure OpenAI) ———
# ★ محسوم بتنفيذ حقيقي (2026-09-19): المورد الذي فيه النشر هو bp-ai-ksa-2026
# (Azure OpenAI، Sweden Central، مجموعة bp-ai). أما drbahermagnas-6763-resource
# (مشروع Foundry، East US 2) فجدول Deployments فيه فارغ.
# مفتاحٌ صحيح على المورد الخطأ يفشل بـ«not found» — خطأ عنوان يبدو خطأ مفتاح.
AZURE_OPENAI_RESOURCE=bp-ai-ksa-2026
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_API_KEY=
# ★ اسم النشر (deployment)، لا اسم الموديل — الخلط يعطي «could not be found».
#   المنشور فعلاً: bp-main (وهو gpt-4.1). تحقّق منه تنفيذٌ حقيقي لا قراءةُ إعداد.
AZURE_OPENAI_DEPLOYMENT=bp-main

# ——— الاحتياطي المحلي (Ollama) ———
# اختياري. يعمل حين يتعذّر Azure — لا بدلاً عنه: جهازٌ ينام يوقف الفريق.
# ومع وجوده تُقلَّل محاولات Azure من أربع إلى اثنتين، فالتحويل ٣ ثوانٍ لا ١٤.
#   ollama pull qwen2.5:7b
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=

# ——— القاعدة (نفس قاعدة الموقع) ———
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# أو للتطوير بلا مساس ببيانات عملاء:
# LOCAL_DB=1

# ——— الإرسال الفعلي (طبقة موصّلات n8n) ———
# بدونهما يعمل كل شيء لكن الرسائل تُحاكى ولا تصل عميلاً.
BP_N8N_BASE=
BP_N8N_HOOK_KEY=
OWNER_WHATSAPP=

# ——— أمان التجربة ———
# 1 = لا رسالة تخرج مهما طلب الوكيل. استعمله في أول تشغيل دائماً.
AGENTS_DRY_RUN=1
