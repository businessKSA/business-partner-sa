{
 "program_ar": "برنامج نطاقات المطور",
 "decision": {
  "number": "182495",
  "page_published": "2026-01-22 (03-شعبان-1447)",
  "original_effective": "1443/4/26هـ الموافق 2021-12-01 (الفقرة رابعاً من القرار)",
  "new_phase": "مرحلة جديدة من 2026 لمدة ثلاث سنوات (2026-2028) بهدف توطين أكثر من 340 ألف وظيفة (خبر الوزارة 2026-01-22)",
  "note": "الصفحة الرسمية تسمّي القرار «قرار وزاري نطاقات المطور 182495»؛ ترويسة ملف القرار PDF (182495.pdf) غير مقروءة بدقة (التاريخ المكتوب 1442/10/11 يتعارض مع كون التنفيذ 1443/4/26) فلا يُعتمد تاريخ إصدار القرار الأصلي."
 },
 "legal_basis_ar": "المادة الحادية عشرة مكرر والمادة السادسة والعشرون من نظام العمل؛ الأمر السامي 38100 وتاريخ 1433/8/15هـ (الموافقة على برنامج نطاقات)؛ القرار 4040 وتاريخ 1432/10/12هـ (وثيقة برنامج تحفيز المنشآت لتوطين الوظائف «نطاقات»)؛ القرار 939 وتاريخ 1438/6/20هـ (تعديل نسب التوطين للأنشطة)",
 "definitions_ar": {
  "نسبة التوطين": "مجموع متوسطات العمالة السعودية بمنشآت الكيان ÷ (مجموع متوسطات العمالة السعودية + مجموع متوسطات العمالة الوافدة بمنشآت الكيان) × 100",
  "الكيان": "الصفة التي تتعامل معها الوزارة لأغراض حساب التوطين والاستقدام ونقل الخدمة وتمثيل جميع الفروع لذات النشاط الاقتصادي المملوكة لمنشأة واحدة",
  "العمالة الوافدة": "العاملون من غير مواطني دول مجلس التعاون الخليجي ويعملون لمصلحة صاحب عمل في المملكة",
  "المنشأة": "كل مشروع يديره شخص طبيعي أو اعتباري يشغل عاملاً أو أكثر لقاء أجر",
  "النطاق": "تصنيف تابع لبرنامج نطاقات يعتمد على نسبة التوطين لدى المنشأة"
 },
 "bands_ar": [
  "أحمر",
  "أخضر منخفض",
  "أخضر متوسط",
  "أخضر مرتفع",
  "بلاتيني"
 ],
 "formula_ar": "ص = م × لوغ(س) + ث  حيث ص النسبة الدنيا للنطاق، م قيمة ثابتة للمنحنى لكل نطاق ونشاط (المرفق 1)، ث قيمة ثابتة لتوطين كل نطاق ونشاط وسنة (2026/2027/2028 ثم ما بعدها)، س إجمالي عمالة الكيان، لوغ(س) اللوغاريتم الطبيعي. تُحسب أربع قيم: أخضر منخفض، متوسط، مرتفع، بلاتيني.",
 "band_assignment_ar": "ن = نسبة توطين الكيان: ن < ص(أخضر منخفض) ← أحمر؛ ص(منخفض) ≤ ن < ص(متوسط) ← أخضر منخفض؛ ص(متوسط) ≤ ن < ص(مرتفع) ← أخضر متوسط؛ ص(مرتفع) ≤ ن < ص(بلاتيني) ← أخضر مرتفع؛ ن ≥ ص(بلاتيني) ← بلاتيني.",
 "update_cadence_ar": "احتساب فوري عند إضافة عامل (ضمن التحديث الأسبوعي لنطاقات حسب الأسئلة الشائعة)؛ ويمكن للمنشأة معرفة عدد السعوديين المطلوب تعيينهم عبر خدمة «دليل نطاقات التفاعلي» في منصة قوى وحاسبة نطاقات المطور.",
 "services_by_band_ar": {
  "بلاتيني": [
   "استقبال طلبات رصيد التأشيرات للمهن المتاحة",
   "القدرة على تغيير مهن العمالة الوافدة للمهن المتاحة (مع مراعاة متطلبات تغيير المهنة)",
   "تجديد رخص العمل للعمالة الوافدة بغض النظر عن مدة إقامتها بشرط ألا يزيد المتبقي في إقامة العامل عن ستة أشهر عند التجديد",
   "نقل الخدمات للعمالة الوافدة من أي نطاق (مع مراعاة الضوابط)",
   "الاحتساب الفوري في برنامج نطاقات"
  ],
  "أخضر مرتفع": [
